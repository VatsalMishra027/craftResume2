---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<a
  href="/"
  class={`group inline-flex items-center gap-2.5 ${className}`}
  aria-label="CraftResume home"
>
  <span
    class="grid size-7 place-items-center rounded-md bg-ink text-paper transition-transform duration-300 ease-(--ease-out-soft) group-hover:-rotate-6"
  >
    <svg viewBox="0 0 16 16" fill="none" class="size-4" aria-hidden="true">
      <path
        d="M4 3.2h5.1L12 6.1V12.8H4V3.2Z"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linejoin="round"></path>
      <path d="M8.8 3.4v2.9H11.7" stroke="currentColor" stroke-width="1.3"></path>
      <path d="M5.9 8.6h4.2M5.9 10.6h2.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
    </svg>
  </span>
  <span class="text-[15px] font-semibold tracking-[-0.02em]">
    Craft<span class="text-ink-muted">Resume</span>
  </span>
</a>
