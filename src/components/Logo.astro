---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<a
  href="/"
  class={`group inline-flex items-center gap-2.5 ${className}`}
  aria-label="CraftResume home"
>
  <svg
    viewBox="0 0 64 64"
    class="size-8 shrink-0 transition-transform duration-300 ease-(--ease-out-soft) group-hover:-rotate-6"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="cr-g" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#b8501f"></stop><stop offset="1" stop-color="#f0a070"></stop>
      </linearGradient>
    </defs>
    <rect width="64" height="64" rx="14" fill="#16150f"></rect>
    <path d="M18 10h20l10 10v34H18z" fill="url(#cr-g)"></path>
    <path d="M38 10v10h10z" fill="#faf9f6" opacity=".9"></path>
    <path d="M25 30h7M25 37h12M25 44h17" stroke="#16150f" stroke-width="3.4" stroke-linecap="round"></path>
  </svg>
  <span class="text-[15px] font-semibold tracking-[-0.02em]">
    Craft<span class="text-ink-muted">Resume</span>
  </span>
</a>
