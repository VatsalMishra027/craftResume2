---
import { renderResume, sheetClass, sheetStyle } from '../lib/render';
import { SAMPLE_RESUME } from '../lib/sample';
import { DEFAULT_ACCENT } from '../lib/templates';
import type { ResumeData } from '../lib/types';
import '../styles/resume.css';

interface Props {
  templateId: string;
  accentId?: string;
  /** Content to render. Defaults to the shared sample resume. */
  data?: ResumeData;
  class?: string;
}

const {
  templateId,
  accentId = DEFAULT_ACCENT,
  data = SAMPLE_RESUME,
  class: className = '',
} = Astro.props;
// Decorative, and often wrapped in a link of its own — so no anchors inside.
// Everything else about this render matches the editor's, right down to the
// stand-in portrait on the photo layouts, so the sheet on the card is the
// sheet the editor opens.
const html = renderResume(data, templateId, { links: false });
---

<div class={`sheet-fit sheet-fit--page ${className}`} data-sheet-fit="page" aria-hidden="true">
  <div class={sheetClass(templateId)} style={sheetStyle(accentId)} set:html={html} />
</div>
