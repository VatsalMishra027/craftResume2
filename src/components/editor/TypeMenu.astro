---
/**
 * Typeface and text size for the sheet.
 *
 * One menu rather than two controls in the bar: the two settings are always
 * adjusted together — you pick a face, then find the size that makes it fit —
 * and the sample line under the faces is the only honest way to choose one.
 *
 * The same menu appears in both editors and writes to the same two stored
 * values, so a resume and its letter cannot end up in different type.
 */
import { FONTS, FONT_SIZES } from '../../lib/fonts';
---

<div class="relative" data-menu="type">
  <button type="button" data-menu-button aria-expanded="false" class="bar-button">
    <svg viewBox="0 0 16 16" fill="none" class="size-3.5 text-ink-muted" aria-hidden="true">
      <path
        d="M3 4.2V2.8h10v1.4M8 2.8v10.4M6 13.2h4"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span class="hidden sm:inline" data-font-label>Type</span>
    <span class="text-ink-faint" aria-hidden="true">▾</span>
  </button>

  <div
    data-menu-panel
    hidden
    class="menu-panel absolute left-0 top-11 z-40 max-h-[min(32rem,70vh)] w-[18rem] overflow-y-auto overscroll-contain p-1.5"
  >
    <p class="menu-group">Typeface</p>
    {
      FONTS.map((font) => (
        <button
          type="button"
          data-font={font.id}
          data-font-name={font.name}
          aria-pressed="false"
          class="menu-item flex w-full items-start gap-2.5 text-left"
        >
          <span
            class="mt-1 size-3.5 flex-none rounded-full border border-line-strong"
            data-font-tick
          />
          <span class="min-w-0 flex-1">
            <span
              class="block text-[13px] font-semibold tracking-[-0.01em]"
              style={font.stack ? `font-family:${font.stack}` : undefined}
            >
              {font.name}
            </span>
            <span class="mt-0.5 block text-[11px] leading-snug text-ink-muted">{font.note}</span>
          </span>
        </button>
      ))
    }

    <p class="menu-group mt-1 border-t border-line-strong pt-2.5">Text size</p>
    <div class="grid grid-cols-5 gap-1 px-1.5 pb-1">
      {
        FONT_SIZES.map((size) => (
          <button
            type="button"
            data-font-size={size.id}
            aria-pressed="false"
            title={`${size.name} — ${Math.round(size.scale * 100)}%`}
            class="size-chip"
          >
            <span class="size-chip-glyph">Aa</span>
            <span class="size-chip-label">{Math.round(size.scale * 100)}</span>
          </button>
        ))
      }
    </div>
    <p class="px-2.5 pb-1.5 text-[11px] leading-snug text-ink-muted" data-font-size-note>
      Scales every size on the page together, so the layout keeps its shape.
    </p>
  </div>
</div>
