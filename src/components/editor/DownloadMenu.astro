---
/**
 * Three ways out of an editor: the print dialog for a PDF, a real .docx, and
 * the whole thing as plain text. Everything is produced in the browser.
 *
 * The resume's menu carries one extra switch — whether to staple the cover
 * letter on as a second page. The letter's menu has nothing to attach, so it
 * does not pretend to offer the choice.
 */
interface Props {
  doc: 'resume' | 'cover';
}
const { doc } = Astro.props;

const what = doc === 'cover' ? 'letter' : 'resume';
---

<div class="relative" data-menu="download">
  <button
    type="button"
    data-menu-button
    aria-expanded="false"
    class="inline-flex h-9 items-center gap-2 rounded-full bg-ink px-4 text-sm font-medium text-paper transition-transform duration-200 ease-(--ease-out-soft) hover:-translate-y-px active:translate-y-0"
  >
    <svg viewBox="0 0 16 16" fill="none" class="size-3.5" aria-hidden="true">
      <path
        d="M8 2.5v7m0 0L5.2 6.7M8 9.5l2.8-2.8M3 12.2h10"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span class="hidden sm:inline">Download</span>
    <span class="opacity-70" aria-hidden="true">▾</span>
  </button>

  <div data-menu-panel hidden class="dl-menu absolute right-0 top-11 z-40 w-[19.5rem] p-1.5 shadow-lift">
    <button type="button" class="dl-item" data-download="pdf">
      <span class="dl-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z" />
          <path d="M9 1.8v3.6h3.6M6 9.4h4M6 11.4h2.6" />
        </svg>
      </span>
      <span class="dl-text">
        <span class="dl-title">PDF</span>
        <span class="dl-note">Opens the print dialog. Choose “Save as PDF”.</span>
      </span>
    </button>

    <button type="button" class="dl-item" data-download="docx">
      <span class="dl-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <rect x="2" y="2.6" width="12" height="10.8" rx="1.2" />
          <path d="m4.6 5.8 1.2 4.4 1.4-3.2 1.4 3.2 1.2-4.4" />
        </svg>
      </span>
      <span class="dl-text">
        <span class="dl-title">Word (.docx)</span>
        <span class="dl-note">An editable document, not a picture of one.</span>
      </span>
    </button>

    <button type="button" class="dl-item" data-download="copy">
      <span class="dl-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <rect x="5.4" y="5.4" width="8.2" height="8.2" rx="1.2" />
          <path d="M10.6 5.4V3.6a1.2 1.2 0 0 0-1.2-1.2H3.6a1.2 1.2 0 0 0-1.2 1.2v5.8a1.2 1.2 0 0 0 1.2 1.2h1.8" />
        </svg>
      </span>
      <span class="dl-text">
        <span class="dl-title" data-copy-label>Copy all the text</span>
        <span class="dl-note">Plain text, for a form that will not take a file.</span>
      </span>
    </button>

    {
      doc === 'resume' && (
        <label class="dl-switch">
          <input type="checkbox" data-include-cover />
          <span>
            Include the cover letter
            <span class="dl-note">
              Added as a second page. Written over in the cover letter editor.
            </span>
          </span>
        </label>
      )
    }

    {
      doc === 'cover' && (
        <p class="dl-foot">
          The {what} only. Your resume downloads from its own editor.
        </p>
      )
    }
  </div>
</div>
