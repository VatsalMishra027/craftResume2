---
/**
 * The two documents, as two places rather than two tabs of one editor.
 *
 * A resume and a cover letter are written at different times, for different
 * reasons, and only one of them is needed for most applications — so each gets
 * its own page, its own form and its own download. This is the link between
 * them, and it is a real navigation, not a view toggle.
 */
interface Props {
  active: 'resume' | 'cover';
}
const { active } = Astro.props;

const docs = [
  { key: 'resume', label: 'Resume', href: '/editor' },
  { key: 'cover', label: 'Cover letter', href: '/cover-letter' },
] as const;
---

<nav class="doc-switch" aria-label="Document">
  {
    docs.map((doc) => (
      <a href={doc.href} aria-current={active === doc.key ? 'page' : undefined}>
        {doc.label}
      </a>
    ))
  }
</nav>
