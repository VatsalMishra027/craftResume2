---
/**
 * In-editor modal allowing users to upload and parse a PDF resume directly.
 */
---

<div
  data-modal="import"
  hidden
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-ink/40 backdrop-blur-sm transition-opacity"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-import-title"
>
  <div class="relative w-full max-w-lg rounded-card border border-line bg-surface p-6 sm:p-8 shadow-page transition-transform">
    <!-- Close button -->
    <button
      type="button"
      data-modal-close="import"
      class="absolute right-4 top-4 rounded-full p-1 text-ink-muted hover:text-ink hover:bg-paper-sunk transition-colors"
      aria-label="Close modal"
    >
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4">
        <path d="m3 3 10 10M13 3 3 13" />
      </svg>
    </button>

    <div class="flex items-center gap-3 mb-4">
      <div class="size-10 rounded-full bg-clay-soft text-clay flex items-center justify-center flex-none">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" class="size-5">
          <path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z" />
          <path d="M9 1.8v3.6h3.6M8 8v4m-2-2 2-2 2 2" />
        </svg>
      </div>
      <div>
        <h3 id="modal-import-title" class="text-base font-semibold text-ink">Import Resume PDF</h3>
        <p class="text-xs text-ink-muted">Extract details from your existing resume directly in the browser.</p>
      </div>
    </div>

    <!-- Dropzone Area -->
    <div
      data-modal-dropzone
      class="relative mt-4 flex flex-col items-center justify-center rounded-card border-2 border-dashed border-line-strong bg-paper p-6 text-center transition-colors hover:border-ink cursor-pointer"
    >
      <input
        type="file"
        accept=".pdf,application/pdf"
        data-modal-file-input
        class="absolute inset-0 size-full opacity-0 cursor-pointer z-10"
        aria-label="Choose PDF resume file"
      />
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-8 text-ink-muted">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <polyline points="14 2 14 8 20 8" />
        <path d="M12 18v-6m-3 3 3-3 3 3" />
      </svg>
      <p class="mt-2 text-xs font-semibold text-ink">Click to upload or drag & drop</p>
      <p class="text-[11px] text-ink-faint">Standard PDF with selectable text</p>
    </div>

    <!-- Status / Progress -->
    <div data-modal-status class="hidden mt-4 p-3 rounded-lg bg-paper-sunk text-center">
      <div class="inline-block size-5 animate-spin rounded-full border-2 border-clay border-t-transparent mr-2 align-middle"></div>
      <span class="text-xs font-medium text-ink" data-modal-status-text>Analyzing PDF…</span>
    </div>

    <!-- Extraction Preview Summary (when done) -->
    <div data-modal-preview class="hidden mt-4 rounded-lg border border-line bg-paper-sunk/50 p-4">
      <h4 class="text-xs font-semibold text-ink mb-1.5 flex items-center gap-1.5">
        <span class="size-2 rounded-full bg-emerald-500"></span>
        Extraction Successful
      </h4>
      <p class="text-xs text-ink-soft leading-relaxed" data-modal-preview-summary></p>
      <p class="text-[11px] text-ink-muted mt-2 border-t border-line/60 pt-2">
        Applying will populate all form fields and live A4 preview with the extracted details.
      </p>
    </div>

    <!-- Footer Actions -->
    <div class="mt-6 flex items-center justify-end gap-2.5">
      <button
        type="button"
        data-modal-close="import"
        class="rounded-full border border-line px-4 py-2 text-xs font-medium text-ink-soft hover:text-ink transition-colors"
      >
        Cancel
      </button>
      <button
        type="button"
        data-modal-apply
        disabled
        class="inline-flex items-center rounded-full bg-ink px-5 py-2 text-xs font-semibold text-paper opacity-50 cursor-not-allowed transition-all enabled:opacity-100 enabled:cursor-pointer hover:enabled:-translate-y-px"
      >
        Apply to Resume
      </button>
    </div>
  </div>
</div>
