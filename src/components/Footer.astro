---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-paper-sunk/60">
  <div class="shell flex flex-col gap-8 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-sm">
      <Logo size="lg" />
      <p class="mt-4 text-sm leading-relaxed text-ink-muted">
        A free resume builder and resume maker that stays out of the way. Your details never leave
        your browser.
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-soft" aria-label="Footer">
      <a href="/templates" class="transition-colors hover:text-ink">Templates</a>
      <a href="/editor" class="transition-colors hover:text-ink">Resume editor</a>
      <a href="/cover-letter-templates" class="transition-colors hover:text-ink">Cover letters</a>
      <a href="/#how" class="transition-colors hover:text-ink">How it works</a>
      <a href="/#faq" class="transition-colors hover:text-ink">FAQ</a>
    </nav>
  </div>

  <div
    class="shell flex flex-col gap-4 border-t border-line py-5 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-xs text-ink-faint">© {year} freeresumemakerai.com — Free Resume Maker AI. Built for people who just want the PDF.</p>
    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-ink-muted" aria-label="Company and legal">
      <a href="/about" class="transition-colors hover:text-ink">About us</a>
      <a href="/contact" class="transition-colors hover:text-ink">Contact us</a>
      <a href="/privacy" class="transition-colors hover:text-ink">Privacy policy</a>
      <a href="/terms" class="transition-colors hover:text-ink">Terms &amp; conditions</a>
    </nav>
  </div>
</footer>
