---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-paper-sunk/60">
  <div class="shell flex flex-col gap-8 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-sm">
      <Logo />
      <p class="mt-3 text-sm leading-relaxed text-ink-muted">
        A free resume builder that stays out of the way. Your details never leave your browser.
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-soft" aria-label="Footer">
      <a href="/templates" class="transition-colors hover:text-ink">Templates</a>
      <a href="/editor" class="transition-colors hover:text-ink">Resume editor</a>
      <a href="/cover-letter" class="transition-colors hover:text-ink">Cover letter</a>
      <a href="/#how" class="transition-colors hover:text-ink">How it works</a>
      <a href="/#faq" class="transition-colors hover:text-ink">FAQ</a>
    </nav>
  </div>

  <div class="shell border-t border-line py-5">
    <p class="text-xs text-ink-faint">© {year} CraftResume. Built for people who just want the PDF.</p>
  </div>
</footer>
