---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Field from '../components/editor/Field.astro';
import TemplateMenu from '../components/editor/TemplateMenu.astro';
import AccentMenu from '../components/editor/AccentMenu.astro';
import TypeMenu from '../components/editor/TypeMenu.astro';
import DocSwitch from '../components/editor/DocSwitch.astro';
import DownloadMenu from '../components/editor/DownloadMenu.astro';
import '../styles/resume.css';
import '../styles/editor.css';

/** Left rail. `basics` is the one singleton; the rest are lists. */
const panels = [
  { key: 'basics', title: 'Personal Info', icon: 'user' },
  { key: 'experience', title: 'Experience', icon: 'case', add: 'Add a role' },
  { key: 'education', title: 'Education', icon: 'cap', add: 'Add a qualification' },
  { key: 'skills', title: 'Skills', icon: 'star', add: 'Add a skill' },
  { key: 'languages', title: 'Languages', icon: 'globe', add: 'Add a language' },
  { key: 'projects', title: 'Projects', icon: 'doc', add: 'Add a project' },
  { key: 'certifications', title: 'Certifications', icon: 'award', add: 'Add a certification' },
  { key: 'publications', title: 'Publications', icon: 'book', add: 'Add a publication' },
  { key: 'interests', title: 'Interests', icon: 'heart', add: 'Add an interest' },
] as const;

const icons: Record<string, string> = {
  user: '<circle cx="8" cy="5.4" r="2.6"/><path d="M2.8 13.6a5.2 5.2 0 0 1 10.4 0"/>',
  case: '<rect x="2.2" y="5.4" width="11.6" height="8.2" rx="1.2"/><path d="M6 5.4V3.6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1.8"/>',
  cap: '<path d="m8 2.6 6 2.8-6 2.8-6-2.8z"/><path d="M4.4 6.6v3.6c0 1 1.6 1.8 3.6 1.8s3.6-.8 3.6-1.8V6.6"/>',
  star: '<path d="m8 1.9 1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.7 4.2 13.7l.7-4.3-3.1-3 4.3-.6z"/>',
  globe: '<circle cx="8" cy="8" r="6"/><path d="M2 8h12M8 2c1.8 2 1.8 10 0 12M8 2C6.2 4 6.2 12 8 14"/>',
  doc: '<path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z"/><path d="M9 1.8v3.6h3.6"/>',
  award: '<circle cx="8" cy="6.2" r="3.8"/><path d="M5.6 9.5 4.6 14 8 12.4 11.4 14l-1-4.5"/>',
  book: '<path d="M2.6 3h4a2 2 0 0 1 2 2v8a1.6 1.6 0 0 0-1.6-1.6H2.6z"/><path d="M13.4 3h-4a2 2 0 0 0-2 2v8a1.6 1.6 0 0 1 1.6-1.6h4.4z"/>',
  heart:
    '<path d="M8 13.6S2.2 10.3 2.2 6.4a2.9 2.9 0 0 1 5.8-.9 2.9 2.9 0 0 1 5.8.9c0 3.9-5.8 7.2-5.8 7.2z"/>',
};

/**
 * The reorderable, renameable sections. `basics` sits outside this: it carries
 * the name and contact block rather than a heading of its own.
 */
const listPanels = panels.filter((panel) => panel.key !== 'basics');
---

<Layout title="Editor — CraftResume" bare>
  <div class="flex h-dvh flex-col">
    <!-- Top bar -->
    <header
      class="editor-bar glass-bar glass-edge flex h-14 flex-none items-center justify-between gap-3 px-3 sm:px-5"
    >
      <div class="flex items-center gap-4">
        <Logo class="[&>span:last-child]:hidden sm:[&>span:last-child]:inline" />

        <div class="flex items-center gap-1.5">
          <TemplateMenu />
          <AccentMenu />
          <TypeMenu />
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <DocSwitch active="resume" />

        <span class="hidden text-xs text-ink-faint lg:inline" data-save-status>
          Saved to this browser
        </span>

        <ThemeToggle />
        <DownloadMenu doc="resume" />
      </div>
    </header>

    <!-- Three panes: section rail · form · preview -->
    <div data-view-root data-active-view="edit" class="editor-grid min-h-0 flex-1">
      <!-- Section rail -->
      <nav class="pane-rail border-line bg-paper lg:border-r" aria-label="Sections">
        <p class="rail-heading">Sections</p>
        <ul class="rail-list">
          {
            panels.map((panel) => (
              <li class="rail-row" data-rail={panel.key}>
                <button
                  type="button"
                  data-goto={panel.key}
                  aria-current="false"
                  class="rail-item"
                >
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4 flex-none text-ink-muted"
                    aria-hidden="true"
                    set:html={icons[panel.icon]}
                  />
                  <span class="rail-label truncate" data-rail-label={panel.key}>
                    {panel.title}
                  </span>
                  <span class="rail-count" data-count={panel.key} />
                </button>

                {/* Only the resume's own sections move and retitle. Personal
                    Info carries the name and contact block rather than a
                    heading of its own. */}
                {panel.key !== 'basics' && (
                  <Fragment>
                    <span class="rail-actions">
                      <button
                        type="button"
                        class="rail-btn"
                        data-section-move={panel.key}
                        data-direction="up"
                        aria-label={`Move ${panel.title} up`}
                        title={`Move ${panel.title} up`}
                      >
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-3.5"
                          aria-hidden="true"
                        >
                          <path d="M8 12.8V3.4M8 3.4 4.2 7.2M8 3.4l3.8 3.8" />
                        </svg>
                      </button>

                      <button
                        type="button"
                        class="rail-btn"
                        data-section-move={panel.key}
                        data-direction="down"
                        aria-label={`Move ${panel.title} down`}
                        title={`Move ${panel.title} down`}
                      >
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-3.5"
                          aria-hidden="true"
                        >
                          <path d="M8 3.2v9.4M8 12.6l3.8-3.8M8 12.6 4.2 8.8" />
                        </svg>
                      </button>

                      <button
                        type="button"
                        class="rail-btn"
                        data-section-menu={panel.key}
                        aria-expanded="false"
                        aria-label={`Rename or remove ${panel.title}`}
                        title={`Rename or remove ${panel.title}`}
                      >
                        <svg viewBox="0 0 16 16" fill="currentColor" class="size-3.5" aria-hidden="true">
                          <circle cx="3.6" cy="8" r="1.2" />
                          <circle cx="8" cy="8" r="1.2" />
                          <circle cx="12.4" cy="8" r="1.2" />
                        </svg>
                      </button>
                    </span>

                    <div class="rail-menu" data-section-panel={panel.key} hidden>
                      <button type="button" class="rail-menu-item" data-section-rename={panel.key}>
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="rail-menu-icon"
                          aria-hidden="true"
                        >
                          <path d="M11.2 2.6 13.4 4.8 5.9 12.3 3 13l.7-2.9z" />
                        </svg>
                        Rename heading
                      </button>
                      <button type="button" class="rail-menu-item" data-section-toggle={panel.key}>
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="rail-menu-icon"
                          aria-hidden="true"
                        >
                          <path d="M2.2 8s2.4-4.2 5.8-4.2S13.8 8 13.8 8s-2.4 4.2-5.8 4.2S2.2 8 2.2 8z" />
                          <circle cx="8" cy="8" r="1.6" />
                          <path d="M2.8 2.8 13.2 13.2" data-toggle-slash />
                        </svg>
                        <span data-toggle-label>Remove from resume</span>
                      </button>
                    </div>
                  </Fragment>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Form -->
      <section
        data-editor-form
        class="pane-edit min-h-0 overflow-y-auto border-line bg-paper"
        aria-label="Resume details"
      >
        <div class="mx-auto max-w-2xl px-4 pt-7 pb-28 sm:px-6 lg:pb-10">
          <!-- Personal info -->
          <section data-panel="basics" hidden>
            <h2 class="panel-title">Personal Info</h2>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <Field label="Full name" field="basics.fullName" placeholder="Ananya Rao" />
              <Field label="Job title" field="basics.title" placeholder="Senior Product Designer" />
              <Field label="Email" field="basics.email" type="email" placeholder="you@email.com" />
              <Field label="Phone" field="basics.phone" placeholder="+91 98200 41122" />
              <Field label="Location" field="basics.location" placeholder="Bengaluru, India" />
              <Field label="Website" field="basics.website" placeholder="yourname.com" />
              <Field
                label="LinkedIn"
                field="basics.linkedin"
                placeholder="linkedin.com/in/yourname"
              />
              <Field label="GitHub" field="basics.github" placeholder="github.com/yourname" />
              <Field
                label="Summary"
                field="basics.summary"
                rows={4}
                class="sm:col-span-2"
                placeholder="Two or three lines on what you do and what you are good at."
                hint="Keep it to about 40 words. Specific beats impressive."
              />

              <!-- Headshot. Read off disk, scaled down in the browser, stored
                   with the rest of the draft. Never uploaded anywhere. -->
              <div class="sm:col-span-2">
                <span class="text-xs font-medium text-ink-soft">Photo</span>
                <div class="mt-1.5 flex items-start gap-4">
                  <span class="photo-preview" data-photo-preview>
                    <svg viewBox="0 0 64 64" class="photo-blank" aria-hidden="true">
                      <circle cx="32" cy="24" r="11"></circle>
                      <path d="M8 62a24 24 0 0 1 48 0z"></path>
                    </svg>
                  </span>

                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <label class="photo-button">
                        <input
                          type="file"
                          accept="image/png,image/jpeg,image/webp"
                          data-photo-input
                          class="sr-only"
                        />
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-3.5"
                          aria-hidden="true"
                        >
                          <path d="M8 11.4V2.8M8 2.8 5.2 5.6M8 2.8l2.8 2.8M2.6 10.4v2a1 1 0 0 0 1 1h8.8a1 1 0 0 0 1-1v-2" />
                        </svg>
                        <span data-photo-button-label>Choose a photo</span>
                      </label>

                      <button type="button" data-photo-remove class="photo-remove" hidden>
                        Remove
                      </button>
                    </div>

                    <p class="mt-2 text-[11px] leading-relaxed text-ink-faint" data-photo-hint>
                      JPG, PNG or WebP. Scaled down and stored in this browser — it is never
                      uploaded. Only the five <strong class="font-medium">With Photo</strong>
                      layouts draw it; the rest ignore it. Those five show a drawn stand-in until
                      you add your own, so the page never has a hole in it.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-10 border-t border-line pt-6">
              <div class="flex flex-wrap items-center justify-between gap-4">
                <p class="max-w-xs text-xs leading-relaxed text-ink-faint">
                  Everything here is stored in this browser only. Nothing is uploaded.
                </p>
                <button
                  type="button"
                  data-clear
                  class="rounded-full border border-line px-3.5 py-1.5 text-xs font-medium text-ink-muted transition-colors duration-200 hover:border-clay hover:text-clay"
                >
                  Clear everything
                </button>
              </div>
            </div>
          </section>

          <!-- Repeatable sections -->
          {
            listPanels.map((panel) => (
              <section data-panel={panel.key} hidden>
                <div class="flex items-center justify-between gap-4">
                  <h2 class="panel-title" data-panel-title={panel.key}>
                    {panel.title}
                  </h2>
                  <button
                    type="button"
                    data-add={panel.key}
                    class="inline-flex flex-none items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-medium text-ink transition-colors duration-200 hover:bg-paper-sunk"
                  >
                    <span aria-hidden="true">+</span>
                    {panel.add}
                  </button>
                </div>
                <div class="mt-4 space-y-3" data-list={panel.key} />
              </section>
            ))
          }
        </div>
      </section>

      <!-- Drag to give either side more room. -->
      <div
        data-splitter
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize the editing panel"
        tabindex="0"
        title="Drag to resize · arrow keys to nudge · double-click to reset"
        class="pane-splitter"
      >
        <span class="pane-splitter-grip" aria-hidden="true"></span>
      </div>

      <!-- Live preview -->
      <section class="pane-preview min-h-0 overflow-y-auto bg-paper-sunk" aria-label="Live preview">
        <div class="mx-auto w-full max-w-[900px] px-4 pt-7 pb-28 sm:px-8 lg:pb-10">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs text-ink-faint" data-page-count>Live preview · A4</p>
            <p class="hidden text-xs text-ink-faint sm:block">
              Double-click anything on the page to edit it
            </p>
          </div>

          <div class="sheet-fit sheet-fit--flow rounded-sm shadow-page" data-sheet-fit="flow">
            <div data-preview class="resume-sheet resume-sheet--live t-atlas"></div>
          </div>

          <p
            class="mt-4 hidden text-center text-[11px] leading-relaxed text-ink-faint"
            data-page-note
          >
            The dashed line marks the end of page one. Most recruiters prefer a single page.
          </p>
        </div>
      </section>
    </div>
  </div>

  <!-- Below the split-view breakpoint the two panes share the screen, so the
       switch floats above the content rather than crowding the top bar. -->
  <div
    class="glass fixed bottom-5 left-1/2 z-30 flex -translate-x-1/2 rounded-full p-1 shadow-lift lg:hidden"
    role="group"
    aria-label="Panel"
  >
    <button
      type="button"
      data-view="edit"
      aria-pressed="true"
      class="rounded-full bg-surface px-5 py-2 text-xs font-medium text-ink shadow-sm transition-colors"
    >
      Edit
    </button>
    <button
      type="button"
      data-view="preview"
      aria-pressed="false"
      class="rounded-full px-5 py-2 text-xs font-medium text-ink-muted transition-colors"
    >
      Preview
    </button>
  </div>

  <!-- Populated only at print time, at true A4 size. Kept off screen by the
       .print-root class rather than the `hidden` attribute — see global.css. -->
  <div class="print-root"></div>
</Layout>



<script>
  import { initEditor } from '../scripts/editor';

  initEditor();
</script>
