---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Field from '../components/editor/Field.astro';
import { ACCENTS, ATS_LABEL, templatesByCategory } from '../lib/templates';
import '../styles/resume.css';

/** Left rail. `basics` and `cover` are singletons; the rest are lists. */
const panels = [
  { key: 'basics', title: 'Personal Info', icon: 'user' },
  { key: 'cover', title: 'Cover Letter', icon: 'letter' },
  { key: 'experience', title: 'Experience', icon: 'case', add: 'Add a role' },
  { key: 'education', title: 'Education', icon: 'cap', add: 'Add a qualification' },
  { key: 'skills', title: 'Skills', icon: 'star', add: 'Add a skill' },
  { key: 'languages', title: 'Languages', icon: 'globe', add: 'Add a language' },
  { key: 'projects', title: 'Projects', icon: 'doc', add: 'Add a project' },
  { key: 'certifications', title: 'Certifications', icon: 'award', add: 'Add a certification' },
  { key: 'publications', title: 'Publications', icon: 'book', add: 'Add a publication' },
  { key: 'interests', title: 'Interests', icon: 'heart', add: 'Add an interest' },
] as const;

const icons: Record<string, string> = {
  user: '<circle cx="8" cy="5.4" r="2.6"/><path d="M2.8 13.6a5.2 5.2 0 0 1 10.4 0"/>',
  case: '<rect x="2.2" y="5.4" width="11.6" height="8.2" rx="1.2"/><path d="M6 5.4V3.6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1.8"/>',
  cap: '<path d="m8 2.6 6 2.8-6 2.8-6-2.8z"/><path d="M4.4 6.6v3.6c0 1 1.6 1.8 3.6 1.8s3.6-.8 3.6-1.8V6.6"/>',
  star: '<path d="m8 1.9 1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.7 4.2 13.7l.7-4.3-3.1-3 4.3-.6z"/>',
  globe: '<circle cx="8" cy="8" r="6"/><path d="M2 8h12M8 2c1.8 2 1.8 10 0 12M8 2C6.2 4 6.2 12 8 14"/>',
  doc: '<path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z"/><path d="M9 1.8v3.6h3.6"/>',
  award: '<circle cx="8" cy="6.2" r="3.8"/><path d="M5.6 9.5 4.6 14 8 12.4 11.4 14l-1-4.5"/>',
  book: '<path d="M2.6 3h4a2 2 0 0 1 2 2v8a1.6 1.6 0 0 0-1.6-1.6H2.6z"/><path d="M13.4 3h-4a2 2 0 0 0-2 2v8a1.6 1.6 0 0 1 1.6-1.6h4.4z"/>',
  heart:
    '<path d="M8 13.6S2.2 10.3 2.2 6.4a2.9 2.9 0 0 1 5.8-.9 2.9 2.9 0 0 1 5.8.9c0 3.9-5.8 7.2-5.8 7.2z"/>',
  letter: '<rect x="2" y="3.4" width="12" height="9.2" rx="1.2"/><path d="m2.4 4.4 5.6 4 5.6-4"/>',
};

/**
 * The reorderable, renameable sections. The two singletons sit outside this:
 * `basics` carries the name and contact block rather than a heading of its
 * own, and `cover` is a second document rather than a section of the first.
 */
const listPanels = panels.filter((panel) => panel.key !== 'basics' && panel.key !== 'cover');
---

<Layout title="Editor — CraftResume" bare>
  <div class="flex h-dvh flex-col">
    <!-- Top bar -->
    <header
      class="editor-bar glass-bar glass-edge flex h-14 flex-none items-center justify-between gap-3 px-3 sm:px-5"
    >
      <div class="flex items-center gap-4">
        <Logo class="[&>span:last-child]:hidden sm:[&>span:last-child]:inline" />

        <div class="flex items-center gap-1.5">
          <!-- Template -->
          <div class="relative" data-menu="template">
            <button
              type="button"
              data-menu-button
              aria-expanded="false"
              class="inline-flex h-9 items-center gap-2 rounded-lg border border-line px-3 text-[13px] font-medium text-ink transition-colors duration-150 hover:bg-paper-sunk"
            >
              <svg viewBox="0 0 16 16" fill="none" class="size-3.5 text-ink-muted" aria-hidden="true">
                <path
                  d="M8 1.8 14.2 5 8 8.2 1.8 5zM1.8 8l6.2 3.2L14.2 8M1.8 11l6.2 3.2L14.2 11"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              <span class="hidden sm:inline" data-template-label>Atlas</span>
              <span class="text-ink-faint" aria-hidden="true">▾</span>
            </button>

            <div
              data-menu-panel
              hidden
              class="absolute left-0 top-11 z-40 max-h-[min(32rem,70vh)] w-[19rem] overflow-y-auto overscroll-contain rounded-xl border border-line bg-paper p-1.5 shadow-lift"
            >
              {
                templatesByCategory().map((group) => (
                  <div>
                    <p class="px-2.5 pb-1 pt-2 text-[10px] font-semibold tracking-[0.14em] text-ink-faint uppercase">
                      {group.category}
                    </p>
                    {group.items.map((template) => (
                      <button
                        type="button"
                        data-template={template.id}
                        data-template-name={template.name}
                        aria-pressed="false"
                        class="flex w-full items-start gap-2.5 rounded-lg px-2.5 py-2 text-left transition-colors duration-150 hover:bg-paper-sunk"
                      >
                        <span
                          class="mt-1 size-3.5 flex-none rounded-full border border-line-strong"
                          data-template-tick
                        />
                        <span class="min-w-0 flex-1">
                          <span class="flex items-baseline gap-2">
                            <span class="text-[13px] font-semibold tracking-[-0.01em]">
                              {template.name}
                            </span>
                            <span class="ml-auto flex-none text-[10px] text-ink-faint">
                              {ATS_LABEL[template.ats]}
                            </span>
                          </span>
                          <span class="mt-0.5 block text-[11px] leading-snug text-ink-muted">
                            {template.tagline}
                          </span>
                        </span>
                      </button>
                    ))}
                  </div>
                ))
              }

              <a
                href="/templates?tab=roles"
                class="mt-2 flex items-center justify-between gap-2 rounded-lg border-t border-line px-2.5 pt-2.5 pb-1.5 text-[11px] font-medium text-ink-muted transition-colors duration-150 hover:text-ink"
              >
                Browse role blueprints
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <!-- Colour -->
          <div class="relative" data-menu="accent">
            <button
              type="button"
              data-menu-button
              aria-expanded="false"
              class="inline-flex h-9 items-center gap-2 rounded-lg border border-line px-3 text-[13px] font-medium text-ink transition-colors duration-150 hover:bg-paper-sunk"
            >
              <span class="size-3.5 rounded-full" data-accent-dot></span>
              <span class="hidden sm:inline">Color</span>
              <span class="text-ink-faint" aria-hidden="true">▾</span>
            </button>

            <div
              data-menu-panel
              hidden
              class="absolute left-0 top-11 z-40 w-[15.5rem] rounded-xl border border-line bg-paper p-3 shadow-lift"
            >
              <p class="pb-2.5 text-[10px] font-semibold tracking-[0.14em] text-ink-faint uppercase">
                Print accent colors
              </p>
              <div class="grid grid-cols-4 gap-2.5">
                {
                  ACCENTS.map((accent) => (
                    <button
                      type="button"
                      data-accent={accent.id}
                      aria-pressed="false"
                      title={accent.name}
                      style={`background:${accent.hex}`}
                      class="grid size-9 place-items-center rounded-full text-paper transition-transform duration-150 hover:scale-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
                    >
                      <svg
                        viewBox="0 0 16 16"
                        fill="none"
                        class="size-4 opacity-0"
                        data-accent-tick
                        aria-hidden="true"
                      >
                        <path
                          d="m3.4 8.4 3 3 6.2-6.6"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span class="sr-only">{accent.name}</span>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <span class="hidden text-xs text-ink-faint lg:inline" data-save-status>
          Saved to this browser
        </span>

        <ThemeToggle />

        <!-- Download: three formats and one switch, rather than a button that
             only ever opens the print dialog. -->
        <div class="relative" data-menu="download">
          <button
            type="button"
            data-menu-button
            aria-expanded="false"
            class="inline-flex h-9 items-center gap-2 rounded-full bg-ink px-4 text-sm font-medium text-paper transition-transform duration-200 ease-(--ease-out-soft) hover:-translate-y-px active:translate-y-0"
          >
            <svg viewBox="0 0 16 16" fill="none" class="size-3.5" aria-hidden="true">
              <path
                d="M8 2.5v7m0 0L5.2 6.7M8 9.5l2.8-2.8M3 12.2h10"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span class="hidden sm:inline">Download</span>
            <span class="opacity-60" aria-hidden="true">▾</span>
          </button>

          <div
            data-menu-panel
            hidden
            class="dl-menu absolute right-0 top-11 z-40 w-[19.5rem] rounded-xl p-1.5 shadow-lift"
          >
            <button type="button" class="dl-item" data-download="pdf">
              <span class="dl-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                  <path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z" />
                  <path d="M9 1.8v3.6h3.6M6 9.4h4M6 11.4h2.6" />
                </svg>
              </span>
              <span class="dl-text">
                <span class="dl-title">PDF</span>
                <span class="dl-note">Opens the print dialog. Choose “Save as PDF”.</span>
              </span>
            </button>

            <button type="button" class="dl-item" data-download="docx">
              <span class="dl-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                  <rect x="2" y="2.6" width="12" height="10.8" rx="1.2" />
                  <path d="m4.6 5.8 1.2 4.4 1.4-3.2 1.4 3.2 1.2-4.4" />
                </svg>
              </span>
              <span class="dl-text">
                <span class="dl-title">Word (.docx)</span>
                <span class="dl-note">An editable document, not a picture of one.</span>
              </span>
            </button>

            <button type="button" class="dl-item" data-download="copy">
              <span class="dl-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                  <rect x="5.4" y="5.4" width="8.2" height="8.2" rx="1.2" />
                  <path d="M10.6 5.4V3.6a1.2 1.2 0 0 0-1.2-1.2H3.6a1.2 1.2 0 0 0-1.2 1.2v5.8a1.2 1.2 0 0 0 1.2 1.2h1.8" />
                </svg>
              </span>
              <span class="dl-text">
                <span class="dl-title" data-copy-label>Copy all the text</span>
                <span class="dl-note">Plain text, for a form that will not take a file.</span>
              </span>
            </button>

            <label class="dl-switch">
              <input type="checkbox" data-include-cover />
              <span>
                Include the cover letter
                <span class="dl-note">Added as a second page to whichever format you pick.</span>
              </span>
            </label>
          </div>
        </div>
      </div>
    </header>

    <!-- Three panes: section rail · form · preview -->
    <div data-view-root data-active-view="edit" class="editor-grid min-h-0 flex-1">
      <!-- Section rail -->
      <nav class="pane-rail border-line bg-paper lg:border-r" aria-label="Sections">
        <p class="rail-heading">Sections</p>
        <ul class="rail-list">
          {
            panels.map((panel) => (
              <li class="rail-row" data-rail={panel.key}>
                <button
                  type="button"
                  data-goto={panel.key}
                  aria-current="false"
                  class="rail-item"
                >
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4 flex-none text-ink-muted"
                    aria-hidden="true"
                    set:html={icons[panel.icon]}
                  />
                  <span class="rail-label truncate" data-rail-label={panel.key}>
                    {panel.title}
                  </span>
                  <span class="rail-count" data-count={panel.key} />
                </button>

                {/* Only the resume's own sections move and retitle. Personal
                    Info carries the name and contact block rather than a
                    heading, and the cover letter is a separate document. */}
                {panel.key !== 'basics' && panel.key !== 'cover' && (
                  <Fragment>
                    <span class="rail-actions">
                      <button
                        type="button"
                        class="rail-btn"
                        data-section-move={panel.key}
                        data-direction="up"
                        aria-label={`Move ${panel.title} up`}
                        title={`Move ${panel.title} up`}
                      >
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-3.5"
                          aria-hidden="true"
                        >
                          <path d="M8 12.8V3.4M8 3.4 4.2 7.2M8 3.4l3.8 3.8" />
                        </svg>
                      </button>

                      <button
                        type="button"
                        class="rail-btn"
                        data-section-move={panel.key}
                        data-direction="down"
                        aria-label={`Move ${panel.title} down`}
                        title={`Move ${panel.title} down`}
                      >
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-3.5"
                          aria-hidden="true"
                        >
                          <path d="M8 3.2v9.4M8 12.6l3.8-3.8M8 12.6 4.2 8.8" />
                        </svg>
                      </button>

                      <button
                        type="button"
                        class="rail-btn"
                        data-section-menu={panel.key}
                        aria-expanded="false"
                        aria-label={`Rename or remove ${panel.title}`}
                        title={`Rename or remove ${panel.title}`}
                      >
                        <svg viewBox="0 0 16 16" fill="currentColor" class="size-3.5" aria-hidden="true">
                          <circle cx="3.6" cy="8" r="1.2" />
                          <circle cx="8" cy="8" r="1.2" />
                          <circle cx="12.4" cy="8" r="1.2" />
                        </svg>
                      </button>
                    </span>

                    <div class="rail-menu" data-section-panel={panel.key} hidden>
                      <button type="button" class="rail-menu-item" data-section-rename={panel.key}>
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="rail-menu-icon"
                          aria-hidden="true"
                        >
                          <path d="M11.2 2.6 13.4 4.8 5.9 12.3 3 13l.7-2.9z" />
                        </svg>
                        Rename heading
                      </button>
                      <button type="button" class="rail-menu-item" data-section-toggle={panel.key}>
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="rail-menu-icon"
                          aria-hidden="true"
                        >
                          <path d="M2.2 8s2.4-4.2 5.8-4.2S13.8 8 13.8 8s-2.4 4.2-5.8 4.2S2.2 8 2.2 8z" />
                          <circle cx="8" cy="8" r="1.6" />
                          <path d="M2.8 2.8 13.2 13.2" data-toggle-slash />
                        </svg>
                        <span data-toggle-label>Remove from resume</span>
                      </button>
                    </div>
                  </Fragment>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Form -->
      <section
        data-editor-form
        class="pane-edit min-h-0 overflow-y-auto border-line bg-paper"
        aria-label="Resume details"
      >
        <div class="mx-auto max-w-2xl px-4 pt-7 pb-28 sm:px-6 lg:pb-10">
          <!-- Personal info -->
          <section data-panel="basics" hidden>
            <h2 class="panel-title">Personal Info</h2>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <Field label="Full name" field="basics.fullName" placeholder="Ananya Rao" />
              <Field label="Job title" field="basics.title" placeholder="Senior Product Designer" />
              <Field label="Email" field="basics.email" type="email" placeholder="you@email.com" />
              <Field label="Phone" field="basics.phone" placeholder="+91 98200 41122" />
              <Field label="Location" field="basics.location" placeholder="Bengaluru, India" />
              <Field label="Website" field="basics.website" placeholder="yourname.com" />
              <Field
                label="LinkedIn"
                field="basics.linkedin"
                placeholder="linkedin.com/in/yourname"
              />
              <Field label="GitHub" field="basics.github" placeholder="github.com/yourname" />
              <Field
                label="Summary"
                field="basics.summary"
                rows={4}
                class="sm:col-span-2"
                placeholder="Two or three lines on what you do and what you are good at."
                hint="Keep it to about 40 words. Specific beats impressive."
              />

              <!-- Headshot. Read off disk, scaled down in the browser, stored
                   with the rest of the draft. Never uploaded anywhere. -->
              <div class="sm:col-span-2">
                <span class="text-xs font-medium text-ink-soft">Photo</span>
                <div class="mt-1.5 flex items-start gap-4">
                  <span class="photo-preview" data-photo-preview>
                    <svg viewBox="0 0 64 64" class="photo-blank" aria-hidden="true">
                      <circle cx="32" cy="24" r="11"></circle>
                      <path d="M8 62a24 24 0 0 1 48 0z"></path>
                    </svg>
                  </span>

                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <label class="photo-button">
                        <input
                          type="file"
                          accept="image/png,image/jpeg,image/webp"
                          data-photo-input
                          class="sr-only"
                        />
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-3.5"
                          aria-hidden="true"
                        >
                          <path d="M8 11.4V2.8M8 2.8 5.2 5.6M8 2.8l2.8 2.8M2.6 10.4v2a1 1 0 0 0 1 1h8.8a1 1 0 0 0 1-1v-2" />
                        </svg>
                        <span data-photo-button-label>Choose a photo</span>
                      </label>

                      <button type="button" data-photo-remove class="photo-remove" hidden>
                        Remove
                      </button>
                    </div>

                    <p class="mt-2 text-[11px] leading-relaxed text-ink-faint" data-photo-hint>
                      JPG, PNG or WebP. Scaled down and stored in this browser — it is never
                      uploaded. Only the five <strong class="font-medium">With Photo</strong>
                      layouts draw it; the rest ignore it.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-10 border-t border-line pt-6">
              <div class="flex flex-wrap items-center justify-between gap-4">
                <p class="max-w-xs text-xs leading-relaxed text-ink-faint">
                  Everything here is stored in this browser only. Nothing is uploaded.
                </p>
                <button
                  type="button"
                  data-clear
                  class="rounded-full border border-line px-3.5 py-1.5 text-xs font-medium text-ink-muted transition-colors duration-200 hover:border-clay hover:text-clay"
                >
                  Clear everything
                </button>
              </div>
            </div>
          </section>

          <!-- Cover letter: a second document, sharing the resume's contact
               block, accent and type. -->
          <section data-panel="cover" hidden>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="panel-title">Cover Letter</h2>
              <button type="button" data-letter-date class="cover-action">
                Use today’s date
              </button>
            </div>

            <p class="mt-2 max-w-prose text-xs leading-relaxed text-ink-muted">
              Optional, and separate from the resume — the preview switches to it while this panel
              is open. Your name and contact details are taken from Personal Info, so the two
              documents always agree.
            </p>

            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              <Field label="Role applied for" field="cover.role" placeholder="Senior Product Designer" />
              <Field label="Date" field="cover.date" placeholder="12 March 2026" />
              <Field label="Addressed to" field="cover.recipient" placeholder="Hiring Manager" />
              <Field
                label="Their title"
                field="cover.recipientTitle"
                placeholder="Head of Design"
              />
              <Field label="Company" field="cover.company" placeholder="Northwind Systems" />
              <Field
                label="Company location"
                field="cover.companyAddress"
                placeholder="Bengaluru, India"
              />
              <Field
                label="Greeting"
                field="cover.greeting"
                class="sm:col-span-2"
                placeholder="Dear Hiring Manager,"
              />
              <Field
                label="Letter"
                field="cover.body"
                rows={12}
                class="sm:col-span-2"
                placeholder="Why this role. What you have done that proves you can do it. What you would like to happen next."
                hint="Leave a blank line between paragraphs. Three paragraphs is the length people actually read."
              />
              <Field label="Sign-off" field="cover.signOff" placeholder="Sincerely," />
            </div>
          </section>

          <!-- Repeatable sections -->
          {
            listPanels.map((panel) => (
              <section data-panel={panel.key} hidden>
                <div class="flex items-center justify-between gap-4">
                  <h2 class="panel-title" data-panel-title={panel.key}>
                    {panel.title}
                  </h2>
                  <button
                    type="button"
                    data-add={panel.key}
                    class="inline-flex flex-none items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-medium text-ink transition-colors duration-200 hover:bg-paper-sunk"
                  >
                    <span aria-hidden="true">+</span>
                    {panel.add}
                  </button>
                </div>
                <div class="mt-4 space-y-3" data-list={panel.key} />
              </section>
            ))
          }
        </div>
      </section>

      <!-- Drag to give either side more room. -->
      <div
        data-splitter
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize the editing panel"
        tabindex="0"
        title="Drag to resize · arrow keys to nudge · double-click to reset"
        class="pane-splitter"
      >
        <span class="pane-splitter-grip" aria-hidden="true"></span>
      </div>

      <!-- Live preview -->
      <section class="pane-preview min-h-0 overflow-y-auto bg-paper-sunk" aria-label="Live preview">
        <div class="mx-auto w-full max-w-[900px] px-4 pt-7 pb-28 sm:px-8 lg:pb-10">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <!-- Which document the sheet below is showing. -->
              <div class="doc-switch" role="group" aria-label="Document">
                <button type="button" data-doc="resume" aria-pressed="true">Resume</button>
                <button type="button" data-doc="cover" aria-pressed="false">Cover letter</button>
              </div>
              <p class="text-xs text-ink-faint" data-page-count>Live preview · A4</p>
            </div>
            <p class="hidden text-xs text-ink-faint sm:block">
              Double-click anything on the page to edit it
            </p>
          </div>

          <div class="sheet-fit sheet-fit--flow rounded-sm shadow-page" data-sheet-fit="flow">
            <div data-preview class="resume-sheet resume-sheet--live t-atlas"></div>
          </div>

          <p
            class="mt-4 hidden text-center text-[11px] leading-relaxed text-ink-faint"
            data-page-note
          >
            The dashed line marks the end of page one. Most recruiters prefer a single page.
          </p>
        </div>
      </section>
    </div>
  </div>

  <!-- Below the split-view breakpoint the two panes share the screen, so the
       switch floats above the content rather than crowding the top bar. -->
  <div
    class="glass fixed bottom-5 left-1/2 z-30 flex -translate-x-1/2 rounded-full p-1 shadow-lift lg:hidden"
    role="group"
    aria-label="Panel"
  >
    <button
      type="button"
      data-view="edit"
      aria-pressed="true"
      class="rounded-full bg-surface px-5 py-2 text-xs font-medium text-ink shadow-sm transition-colors"
    >
      Edit
    </button>
    <button
      type="button"
      data-view="preview"
      aria-pressed="false"
      class="rounded-full px-5 py-2 text-xs font-medium text-ink-muted transition-colors"
    >
      Preview
    </button>
  </div>

  <!-- Populated only at print time, at true A4 size. Kept off screen by the
       .print-root class rather than the `hidden` attribute — see global.css. -->
  <div class="print-root"></div>
</Layout>

<style>
  /* --split is the form pane's width in rem; the splitter writes to it. */
  .editor-grid {
    --rail: 12.5rem;
    --split: 27rem;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .pane-rail {
    overflow-x: auto;
    overflow-y: hidden;
    border-bottom: 1px solid var(--color-line);
  }

  .rail-heading {
    display: none;
  }

  .rail-list {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    min-width: max-content;
  }

  .rail-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .rail-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 auto;
    min-width: 0;
    border-radius: 0.5rem;
    padding: 0.5rem 0.7rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .rail-item:hover {
    background: var(--color-paper-sunk);
  }

  .rail-item[aria-current="true"] {
    background: var(--color-paper-sunk);
    color: var(--color-ink);
    font-weight: 600;
  }

  .rail-item[aria-current="true"] svg {
    color: var(--color-ink);
  }

  .rail-count {
    margin-left: auto;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-faint);
    padding-left: 0.5rem;
    transition: opacity 150ms ease;
  }

  .rail-count:empty {
    display: none;
  }

  /* A section the user has taken off the sheet still lists here, so the
     content is not lost and one click puts the heading back. */
  .rail-row[data-hidden="true"] .rail-item {
    color: var(--color-ink-faint);
  }

  .rail-row[data-hidden="true"] .rail-label {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  /* Move up · move down · rename or remove. One cluster so the three read as
     one set of controls for the row rather than three unrelated glyphs. */
  .rail-actions {
    display: flex;
    align-items: center;
    gap: 0.0625rem;
    flex: none;
  }

  .rail-btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.375rem;
    color: var(--color-ink-faint);
    transition:
      background-color 120ms ease,
      color 120ms ease,
      opacity 120ms ease;
  }

  .rail-btn:hover,
  .rail-btn[aria-expanded="true"] {
    background: var(--color-line);
    color: var(--color-ink);
  }

  /* The page's focus ring is sized for full-width controls; on a 24px button
     in a 200px rail it reads as a box drawn around the icon. Tighten it. */
  .rail-btn:focus-visible {
    outline-offset: 1px;
  }

  /* At the ends of the list there is nowhere to go. The button stays put so
     the cluster does not reflow, but it stops looking like it will do
     something — and the cursor says so too. */
  .rail-btn:disabled {
    opacity: 0.25;
  }

  .rail-btn:disabled:hover {
    background: none;
    color: var(--color-ink-faint);
  }

  /* Where there is a pointer the controls stay out of the layout until wanted,
     so a long section name keeps the whole row to itself at rest, and they
     take the count's place rather than crowding it. The strip carries the
     row's own hover colour, so the name passes cleanly underneath instead of
     colliding with the icons. On touch there is no hover to wait for, so they
     sit in the row and both fit. */
  @media (hover: hover) {
    .rail-actions {
      position: absolute;
      right: 0.25rem;
      top: 50%;
      transform: translateY(-50%);
      opacity: 0;
      pointer-events: none;
      padding-left: 1.5rem;
      border-radius: 0.375rem;
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--color-paper-sunk), transparent 100%),
        var(--color-paper-sunk) 1.5rem
      );
      transition: opacity 150ms ease;
    }

    /* `:focus-visible`, not `:focus-within`. Clicking "move up" leaves focus
       on the button — and under :focus-within the arrows then stayed on
       screen after the pointer had left the row, which is not what a hover
       affordance should do. A mouse click does not raise :focus-visible, so
       the strip now disappears with the pointer, while a keyboard user
       tabbing through still keeps the controls they are aiming at. */
    .rail-row:hover .rail-actions,
    .rail-row:has(:focus-visible) .rail-actions,
    .rail-row:has(.rail-btn[aria-expanded="true"]) .rail-actions {
      opacity: 1;
      pointer-events: auto;
    }

    .rail-row:hover .rail-count,
    .rail-row:has(:focus-visible) .rail-count,
    .rail-row:has(.rail-btn[aria-expanded="true"]) .rail-count {
      opacity: 0;
    }
  }

  /* Fixed, and placed by script: the rail scrolls in both layouts, and an
     absolutely positioned menu would be clipped by it. */
  .rail-menu {
    position: fixed;
    z-index: 50;
    width: 13.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    padding: 0.3125rem;
    box-shadow: var(--shadow-lift);
  }

  .rail-menu-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    border-radius: 0.5rem;
    padding: 0.5rem 0.5rem;
    text-align: left;
    font-size: 0.8125rem;
    line-height: 1.25;
    color: var(--color-ink);
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .rail-menu-item:hover {
    background: var(--color-paper-sunk);
  }

  .rail-menu-item:focus-visible {
    outline-offset: -1px;
  }

  .rail-menu-icon {
    width: 0.9375rem;
    height: 0.9375rem;
    flex: none;
    color: var(--color-ink-muted);
    transition: color 150ms ease;
  }

  .rail-menu-item:hover .rail-menu-icon {
    color: inherit;
  }

  .rail-menu-item[data-section-toggle]:hover {
    color: var(--color-clay);
    background: var(--color-clay-soft);
  }

  /* Taking a section off the sheet is the one destructive thing in the menu,
     so it sits below a rule rather than looking like a peer of "rename". */
  .rail-menu-item[data-section-toggle] {
    margin-top: 0.25rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.5625rem;
    border-radius: 0.5rem;
  }

  /* The eye is crossed out while the section is on the sheet, because that is
     what the click will do to it; once it is off, the plain eye offers it back. */
  .rail-row[data-hidden="true"] [data-toggle-slash] {
    display: none;
  }

  .rail-row[data-renaming="true"] .rail-item,
  .rail-row[data-renaming="true"] .rail-actions {
    display: none;
  }

  /* Global: the input is built by the editor script at rename time, so it never
     carries this component's scoping attribute and a scoped rule misses it. */
  :global(.rail-rename) {
    width: 100%;
    min-width: 0;
    border-radius: 0.5rem;
    border: 1px solid var(--color-ink);
    background: var(--color-surface);
    /* Matches .rail-item's box, so the row does not jump on the way in. */
    padding: 0.5rem 0.7rem;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-ink), transparent 92%);
  }

  :global(.rail-rename:focus) {
    outline: none;
  }

  .panel-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .pane-splitter {
    display: none;
  }

  /* One pane at a time below the split-view breakpoint. */
  @media (width < 64rem) {
    [data-active-view="edit"] .pane-preview,
    [data-active-view="preview"] .pane-edit,
    [data-active-view="preview"] .pane-rail {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .editor-grid {
      grid-template-rows: minmax(0, 1fr);
      grid-template-columns: var(--rail) var(--split) 0.5rem minmax(0, 1fr);
    }

    .pane-rail {
      overflow-x: hidden;
      overflow-y: auto;
      border-bottom: 0;
      padding: 1.5rem 0.75rem;
    }

    .rail-heading {
      display: block;
      padding: 0 0.7rem 0.6rem;
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-ink-faint);
    }

    .rail-list {
      display: block;
      padding: 0;
      min-width: 0;
    }

    .rail-list li + li {
      margin-top: 0.125rem;
    }

    .pane-splitter {
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: col-resize;
      background: var(--color-line);
      transition: background-color 150ms ease;
      touch-action: none;
    }

    .pane-splitter:hover,
    .pane-splitter:focus-visible,
    .pane-splitter[data-dragging="true"] {
      background: var(--color-line-strong);
      outline: none;
    }

    .pane-splitter-grip {
      width: 2px;
      height: 2.25rem;
      border-radius: 999px;
      background: var(--color-ink-faint);
      opacity: 0;
      transition: opacity 150ms ease;
    }

    .pane-splitter:hover .pane-splitter-grip,
    .pane-splitter:focus-visible .pane-splitter-grip,
    .pane-splitter[data-dragging="true"] .pane-splitter-grip {
      opacity: 1;
    }

    /* While dragging, the pointer must not select text or hit the iframe-ish
       preview surface. */
    :global(body[data-resizing="true"]) {
      cursor: col-resize;
      user-select: none;
    }
  }

  /* --- Chrome --------------------------------------------------------------
     The top bar is glass so the preview scrolling under it stays visible at
     the edge, which is what tells you the sheet is a document and the bar is
     an overlay on top of it.
  --------------------------------------------------------------------------- */
  .editor-bar {
    position: relative;
    z-index: 30;
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 60%, transparent);
  }

  /* Every floating panel in the editor is cut from the same glass. */
  :global([data-menu-panel]),
  .rail-menu,
  .dl-menu {
    background: color-mix(in srgb, var(--color-surface) var(--glass-tint-strong), transparent);
    backdrop-filter: blur(var(--glass-blur)) saturate(1.5);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.5);
    border: 1px solid var(--glass-line);
  }

  /* --- Document switch ---------------------------------------------------- */
  .doc-switch {
    display: inline-flex;
    padding: 0.1875rem;
    border-radius: 999px;
    border: 1px solid var(--glass-line);
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .doc-switch button {
    border-radius: 999px;
    padding: 0.3125rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink-muted);
    white-space: nowrap;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .doc-switch button:hover {
    color: var(--color-ink);
  }

  .doc-switch button[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* --- Download menu ------------------------------------------------------- */
  .dl-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    width: 100%;
    border-radius: 0.625rem;
    padding: 0.625rem 0.6875rem;
    text-align: left;
    transition: background-color 150ms ease;
  }

  .dl-item:hover {
    background: var(--color-paper-sunk);
  }

  .dl-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.0625rem;
    border-radius: 0.5rem;
    color: var(--color-ink-soft);
    background: var(--color-paper-sunk);
    border: 1px solid var(--color-line);
  }

  .dl-item:hover .dl-icon {
    color: var(--color-ink);
    border-color: var(--color-line-strong);
  }

  .dl-text {
    min-width: 0;
  }

  .dl-title {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .dl-note {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.6875rem;
    line-height: 1.4;
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  /* The one thing in the menu that is a setting rather than an action, so it
     sits below a rule instead of reading as a fourth format. */
  .dl-switch {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.25rem;
    border-top: 1px solid var(--color-line);
    padding: 0.6875rem 0.6875rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .dl-switch input {
    margin-top: 0.125rem;
    accent-color: var(--color-ink);
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
  }

  /* --- Cover letter panel -------------------------------------------------- */
  .cover-action {
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink);
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .cover-action:hover {
    background: var(--color-paper-sunk);
    border-color: var(--color-line-strong);
  }

  /* --- Photo --------------------------------------------------------------- */
  .photo-preview {
    display: grid;
    place-items: center;
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: var(--color-paper-sunk);
    color: var(--color-ink-faint);
  }

  .photo-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hidden the moment there is a real picture to show instead. */
  .photo-blank {
    width: 55%;
    height: 55%;
    fill: currentColor;
    opacity: 0.4;
  }

  .photo-preview:has(img) .photo-blank {
    display: none;
  }

  .photo-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    padding: 0.4375rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .photo-button:hover {
    background: var(--color-paper-sunk);
    border-color: var(--color-line-strong);
  }

  /* The file input inside is visually hidden, so the label carries the ring. */
  .photo-button:has(input:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .photo-remove {
    border-radius: 999px;
    padding: 0.4375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink-muted);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .photo-remove:hover {
    background: var(--color-clay-soft);
    color: var(--color-clay);
  }

</style>

<script>
  import { initEditor } from '../scripts/editor';

  initEditor();
</script>
