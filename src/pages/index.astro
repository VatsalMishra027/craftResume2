---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TemplateCard from '../components/TemplateCard.astro';
import TemplateThumb from '../components/TemplateThumb.astro';
import { TEMPLATES, TEMPLATE_CATEGORIES } from '../lib/templates';
import { BLUEPRINTS } from '../lib/blueprints';
import { LETTERS } from '../lib/letters';

/** One layout per shelf, so the grid shows the range without printing all 12. */
const featured = TEMPLATE_CATEGORIES.map(
  (category) => TEMPLATES.find((template) => template.category === category)!,
).filter(Boolean);

/** The hero stack turns through six layouts that look nothing like each other. */
const bookIds = ['atlas', 'ledger', 'cameo', 'vertex', 'cascade', 'orbit'];
const bookTemplates = bookIds.map((id) => TEMPLATES.find((t) => t.id === id)!).filter(Boolean);

const steps = [
  {
    n: '01',
    title: 'Pick a template',
    body: `${TEMPLATES.length} resume layouts, ${BLUEPRINTS.length} pre-filled role blueprints and ${LETTERS.length} cover letter formats. Swap between them at any point — your content stays put.`,
  },
  {
    n: '02',
    title: 'Fill in your details',
    body: 'A plain form on the left, your real resume on the right. Every keystroke shows up immediately, at full page size.',
  },
  {
    n: '03',
    title: 'Download the PDF',
    body: 'A4, selectable text, no watermark. It reads cleanly for a human and parses cleanly for an ATS.',
  },
];

const promises = [
  {
    title: 'No account, ever',
    body: 'No email, no password, no verification link. Open the editor and start typing.',
    icon: '<path d="M8 1.8 2.6 4.2v4c0 3.2 2.3 5.4 5.4 6.2 3.1-.8 5.4-3 5.4-6.2v-4z"/><path d="m5.8 8 1.6 1.6L10.4 6.4"/>',
  },
  {
    title: 'Stays on your machine',
    body: 'Your details are saved in your own browser. Nothing is uploaded to a server.',
    icon: '<rect x="2.2" y="7.2" width="11.6" height="6.6" rx="1.4"/><path d="M5 7.2V5a3 3 0 0 1 6 0v2.2"/>',
  },
  {
    title: 'Nothing is watermarked',
    body: 'The PDF carries your name and nothing else. No logo, no footer, no trial banner.',
    icon: '<path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z"/><path d="M9 1.8v3.6h3.6"/><path d="M5.9 9.4h4.2"/>',
  },
  {
    title: 'Real text, not a picture',
    body: 'The PDF is rendered as text, so applicant tracking systems can actually read it.',
    icon: '<path d="M3 4.2h10M5.6 4.2v8.4M2.4 12.6h6.4"/><path d="M10.4 8.6h3.2M12 8.6v4"/>',
  },
];

const faqs = [
  {
    q: 'Is CraftResume really free?',
    a: 'Yes. Every template and unlimited downloads, with no watermark and no card required. There is no paid tier to upsell you to.',
  },
  {
    q: 'Do I need to create an account?',
    a: 'No. Your resume is stored in your browser, so you can close the tab and pick it up later on the same device. Clearing your browser data clears the resume too.',
  },
  {
    q: 'Are the templates ATS friendly?',
    a: `All ${TEMPLATES.length} use standard section headings, real text and a single reading order, and each card tells you how strictly it parses. Ledger, Beacon and Meridian are the safest bets when you know the application goes through an automated screen.`,
  },
  {
    q: 'How does the download work?',
    a: 'Download opens your print dialog with the resume already isolated on an A4 page. Choose “Save as PDF” and you get a clean, selectable-text file.',
  },
];
---

<Layout title="CraftResume — Free resume builder, no account needed">
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-paper-sunk/70 to-transparent"
        aria-hidden="true"
      >
      </div>

      <div
        class="shell relative grid gap-14 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16 lg:py-24"
      >
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-xs text-ink-soft"
          >
            <span class="size-1.5 rounded-full bg-clay"></span>
            Free · No account · No watermark
          </p>

          <h1 class="display mt-6 text-[clamp(2.6rem,7vw,4.4rem)]">
            Craft a resume<br />
            <span class="font-serif font-normal italic tracking-[-0.01em]">worth reading.</span>
          </h1>

          <p class="mt-6 max-w-lg text-[17px] leading-relaxed text-ink-soft">
            Choose a template, fill in your details, download the PDF. Then, if the posting asks for
            one, write the cover letter the same way — its own formats, its own editor, the same
            colour and type. No sign-up wall, no credit card, no export that quietly stamps a logo
            on your work.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href="/editor"
              class="inline-flex h-12 items-center rounded-full bg-ink px-7 text-[15px] font-medium text-paper transition-transform duration-200 ease-(--ease-out-soft) hover:-translate-y-0.5 active:translate-y-0"
            >
              Start building
            </a>
            <a
              href="/templates"
              class="inline-flex h-12 items-center rounded-full border border-line-strong px-7 text-[15px] font-medium text-ink transition-colors duration-200 hover:bg-paper-sunk"
            >
              Browse templates
            </a>
            <a
              href="/cover-letter-templates"
              class="inline-flex h-12 items-center gap-2 rounded-full px-3 text-[15px] font-medium text-ink-soft transition-colors duration-200 hover:text-ink"
            >
              Write a cover letter
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-5 border-t border-line pt-7">
            <div>
              <dt class="eyebrow">Resume templates</dt>
              <dd class="mt-1 text-xl font-semibold tabular-nums">{TEMPLATES.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">Letter formats</dt>
              <dd class="mt-1 text-xl font-semibold tabular-nums">{LETTERS.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">Role blueprints</dt>
              <dd class="mt-1 text-xl font-semibold tabular-nums">{BLUEPRINTS.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">Downloads</dt>
              <dd class="mt-1 text-xl font-semibold">Unlimited</dd>
            </div>
            <div>
              <dt class="eyebrow">Data leaves your device</dt>
              <dd class="mt-1 text-xl font-semibold">Never</dd>
            </div>
          </dl>
        </div>

        <!-- Layered preview: the real renderer, not a screenshot. The stack
             turns itself, a page at a time, through four of the templates. -->
        <div class="relative mx-auto w-full max-w-[380px] pb-10 lg:max-w-[440px]">
          <button
            type="button"
            data-book
            aria-label="Turn to the next template"
            class="book block w-[88%] cursor-pointer focus-visible:outline-none"
            style="aspect-ratio: 210 / 297"
          >
            {
              bookTemplates.map((template, index) => (
                <span
                  class="book-page"
                  data-book-page
                  data-name={template.name}
                  data-state={index === 0 ? 'front' : 'stack'}
                  style={`--depth:${index}`}
                >
                  <TemplateThumb templateId={template.id} />
                </span>
              ))
            }
          </button>

          <p class="book-caption text-xs text-ink-muted">
            <span class="font-medium text-ink" data-book-caption>{bookTemplates[0].name}</span>
            <span class="text-ink-faint">
              &nbsp;·&nbsp;<span class="book-count" data-book-count
                >1 / {bookTemplates.length}</span
              >&nbsp;·&nbsp;tap to turn
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="scroll-mt-20 border-t border-line bg-surface/60">
      <div class="shell py-20">
        <p class="eyebrow">How it works</p>
        <h2 class="display mt-3 max-w-2xl text-[clamp(1.9rem,4vw,2.7rem)]">
          Three steps. Roughly ten minutes.
        </h2>

        <ol class="mt-14 grid gap-4 md:grid-cols-3">
          {
            steps.map((step) => (
              <li class="step-card glass glass-edge rounded-card p-7">
                <span class="step-number" aria-hidden="true">
                  {step.n}
                </span>
                <h3 class="mt-1 text-lg font-semibold tracking-[-0.015em]">{step.title}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-ink-muted">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Templates -->
    <section class="border-t border-line">
      <div class="shell py-20">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="eyebrow">Templates</p>
            <h2 class="display mt-3 max-w-xl text-[clamp(1.9rem,4vw,2.7rem)]">
              {TEMPLATES.length} layouts, no filler.
            </h2>
            <p class="mt-4 max-w-md text-ink-muted">
              One from each shelf below — ATS-focused through creative. Every preview is the live
              template rendering real content, so what you see is exactly what prints.
            </p>
          </div>
          <a
            href="/templates"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-ink underline-offset-4 hover:underline"
          >
            See them full size
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((template) => <TemplateCard template={template} />)}
        </div>

        <div
          class="mt-14 flex flex-col items-start justify-between gap-5 rounded-card border border-line bg-surface p-7 sm:flex-row sm:items-center"
        >
          <div>
            <p class="eyebrow">Fast start</p>
            <h3 class="mt-2 text-lg font-semibold tracking-[-0.015em]">
              Or open one already written for your job.
            </h3>
            <p class="mt-1.5 max-w-lg text-sm leading-relaxed text-ink-muted">
              {BLUEPRINTS.length} role blueprints — engineering, product, data, finance, marketing,
              design, healthcare and executive — each arriving as a finished resume you edit over
              instead of an empty form.
            </p>
          </div>
          <a
            href="/templates?tab=roles"
            class="inline-flex h-11 flex-none items-center rounded-full border border-line-strong px-6 text-sm font-medium text-ink transition-colors duration-200 hover:bg-paper-sunk"
          >
            See the blueprints
          </a>
        </div>
      </div>
    </section>

    <!-- Promises -->
    <section class="border-t border-line bg-surface/60">
      <div class="shell py-20">
        <p class="eyebrow">What you get</p>
        <h2 class="display mt-3 max-w-2xl text-[clamp(1.9rem,4vw,2.7rem)]">
          The parts other builders charge for.
        </h2>

        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            promises.map((item) => (
              <div class="promise-card glass glass-edge rounded-card p-6">
                <span class="promise-icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-[1.15rem]"
                    set:html={item.icon}
                  />
                </span>
                <h3 class="mt-5 text-[15px] font-semibold tracking-[-0.01em]">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="scroll-mt-20 border-t border-line">
      <div class="shell grid gap-12 py-20 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2 class="display mt-3 text-[clamp(1.9rem,4vw,2.7rem)]">Reasonable questions.</h2>
        </div>

        <div class="divide-y divide-line border-y border-line">
          {
            faqs.map((faq) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[15px] font-medium">
                  {faq.q}
                  <span
                    class="grid size-6 flex-none place-items-center rounded-full border border-line text-ink-muted transition-transform duration-300 ease-(--ease-out-soft) group-open:rotate-45"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 12 12" class="size-3" fill="none">
                      <path
                        d="M6 2v8M2 6h8"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                      />
                    </svg>
                  </span>
                </summary>
                <p class="mt-3 max-w-2xl pr-12 text-sm leading-relaxed text-ink-muted">{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="border-t border-line">
      <div class="shell py-20">
        <div class="cta-card rounded-card px-8 py-16 text-center sm:px-16">
          {/* The space before "away" is written as a non-breaking space on
              purpose: Astro trims the whitespace around a line break between
              an element and the text after it, which closed the gap up. */}
          <h2 class="display mx-auto max-w-3xl text-[clamp(2.2rem,5.2vw,3.5rem)]">
            Your next resume is about <span class="font-serif font-normal italic">ten minutes</span
            >&nbsp;away.
          </h2>
          <p class="cta-sub mx-auto mt-5 max-w-md text-[15px] leading-relaxed">
            No account. No card. Close the tab whenever you like — your draft will be here.
          </p>
          <a
            href="/editor"
            class="cta-button mt-9 inline-flex h-12 items-center rounded-full px-8 text-[15px] font-medium transition-transform duration-200 ease-(--ease-out-soft) hover:-translate-y-0.5 active:translate-y-0"
          >
            Start building
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* --- How it works -------------------------------------------------------
     The step markers used to be 12px of monospace, which read as a footnote
     rather than as the thing numbering the steps. They are now the largest
     element in the card: Space Grotesk at display size, cut off at the
     baseline by the card's own edge so the numerals feel set into the panel
     rather than typed onto it.
  --------------------------------------------------------------------------- */
  .step-card {
    position: relative;
    overflow: hidden;
    transition:
      transform 300ms var(--ease-out-soft),
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .step-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-lift);
  }

  .step-number {
    display: block;
    font-family: var(--font-numeral);
    font-size: clamp(2.75rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
    font-variant-numeric: tabular-nums lining-nums;
    background: linear-gradient(
      160deg,
      var(--color-clay),
      color-mix(in srgb, var(--color-clay) 45%, var(--color-ink))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* A second, much fainter copy of the numeral sitting behind the card's
     corner. It is what stops the panel reading as a flat rectangle. */
  .step-card::after {
    content: "";
    position: absolute;
    right: -1.5rem;
    bottom: -3.5rem;
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 30%,
      color-mix(in srgb, var(--color-clay) 14%, transparent),
      transparent 70%
    );
    pointer-events: none;
    transition: opacity 300ms ease;
    opacity: 0.9;
  }

  .step-card:hover::after {
    opacity: 1;
  }

  /* --- What you get ------------------------------------------------------- */
  .promise-card {
    transition:
      transform 300ms var(--ease-out-soft),
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .promise-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-lift);
  }

  .promise-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    color: var(--color-clay);
    background: var(--color-clay-soft);
    border: 1px solid color-mix(in srgb, var(--color-clay) 18%, transparent);
    transition: transform 300ms var(--ease-out-soft);
  }

  .promise-card:hover .promise-icon {
    transform: translateY(-1px) rotate(-4deg);
  }

  /* --- Closing panel ------------------------------------------------------
     Light: an inverted ink panel. Dark: a raised surface with a lit edge —
     an inverted panel there would be a sheet of white in the middle of a
     dark page.
  --------------------------------------------------------------------------- */
  .cta-card {
    background:
      radial-gradient(
        120% 140% at 50% -20%,
        color-mix(in srgb, var(--color-ink) 88%, var(--color-clay)),
        var(--color-ink) 62%
      );
    color: var(--color-paper);
    border: 1px solid transparent;
  }

  .cta-sub {
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }

  .cta-button {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  :root[data-theme="dark"] .cta-card {
    background:
      radial-gradient(
        120% 140% at 50% -20%,
        color-mix(in srgb, var(--color-surface) 70%, var(--color-clay)),
        var(--color-surface) 58%
      );
    color: var(--color-ink);
    border-color: var(--color-line-strong);
  }

  :root[data-theme="dark"] .cta-sub {
    color: var(--color-ink-muted);
  }

  :root[data-theme="dark"] .cta-button {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* No OS-preference twin for the block above: the root always carries an
     explicit `data-theme`, written before the first paint, so `[data-theme]`
     is the only thing a dark rule ever has to match. */
</style>

<script>
  import { observeSheets } from '../lib/fit';
  import { initBook } from '../scripts/book';

  observeSheets();
  initBook();
</script>
