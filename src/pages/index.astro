    font-style: italic;
    font-size: clamp(3.2rem, 7vw, 4.6rem);
    line-height: 1;
    margin: 0.15rem 0 0.25rem;
    background: linear-gradient(120deg, var(--color-clay), #e8855a 55%, #f0a070);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .promise-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 1.625rem 1.5rem 1.375rem;
    border-radius: var(--radius-card);
