  }

  /* Cards rise in one after another the first time the section is seen. */
  [data-promises][data-reveal='pending'] .promise-card {
    opacity: 0;
    transform: translateY(18px);
  }

  [data-promises] .promise-card {
    transition-delay: calc(var(--i, 0) * 90ms), 0ms, 0ms, calc(var(--i, 0) * 90ms);
  }

  [data-promises] .promise-card:hover {
