  .faq-panel[hidden] {
    display: none;
  }

  [data-faq][data-ready] .faq-panel-title {
    display: none;
  }

  .faq-panel-title {
    margin-bottom: 0.9rem;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .faq-list {
    display: grid;
    gap: 0.6rem;
  }

  .faq-item {
    border-radius: 1rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    transition:
      border-color 250ms ease,
      box-shadow 250ms ease;
  }

  .faq-item:hover {
    border-color: var(--color-line-strong);
  }

  .faq-item[open] {
    border-color: color-mix(in srgb, var(--color-clay) 30%, var(--color-line-strong));
    box-shadow: 0 14px 30px -22px color-mix(in srgb, var(--color-clay) 55%, rgb(22 21 15 / 0.3));
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.05rem 1.25rem;
    list-style: none;
    cursor: pointer;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.4;
  }

  .faq-toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid var(--color-line-strong);
    color: var(--color-ink-muted);
    transition:
      transform 300ms var(--ease-out-soft),
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
  }

  .faq-item[open] .faq-toggle {
    transform: rotate(45deg);
    background: var(--color-clay);
    border-color: var(--color-clay);
    color: #fff;
  }

  .faq-a {
    padding: 0 3.5rem 1.2rem 1.25rem;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-pulse {
      animation: none;
    }
    .fs-button,
    .fs-arrow,
    .fs-chips a,
    .faq-toggle {
      transition: none;
    }
  }
  /* --- Closing panel ------------------------------------------------------
     Light: an inverted ink panel. Dark: a raised surface with a lit edge —
     an inverted panel there would be a sheet of white in the middle of a
     dark page.
  --------------------------------------------------------------------------- */
  .cta-card {
    background:
      radial-gradient(
        120% 140% at 50% -20%,
        color-mix(in srgb, var(--color-ink) 88%, var(--color-clay)),
        var(--color-ink) 62%
      );
    color: var(--color-paper);
    border: 1px solid transparent;
  }

  .cta-sub {
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }

  .cta-button {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  :root[data-theme="dark"] .cta-card {
    background:
      radial-gradient(
        120% 140% at 50% -20%,
        color-mix(in srgb, var(--color-surface) 70%, var(--color-clay)),
        var(--color-surface) 58%
      );
    color: var(--color-ink);
    border-color: var(--color-line-strong);
  }

  :root[data-theme="dark"] .cta-sub {
    color: var(--color-ink-muted);
  }

  :root[data-theme="dark"] .cta-button {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* No OS-preference twin for the block above: the root always carries an
     explicit `data-theme`, written before the first paint, so `[data-theme]`
     is the only thing a dark rule ever has to match. */
</style>

<script>
  import { observeSheets } from '../lib/fit';
  import { initBook } from '../scripts/book';

  observeSheets();
  initBook();

  // "What you get": cards rise in once, the strike draws across, and a soft
  // spotlight follows the pointer. Decoration only — the cards are fully
  // visible without this script.
  const promises = document.querySelector<HTMLElement>('[data-promises]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (promises && !calm && 'IntersectionObserver' in window) {
    promises.dataset.reveal = 'pending';
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          delete promises.dataset.reveal;
          io.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    io.observe(promises);
  }
  promises?.querySelectorAll<HTMLElement>('[data-promise-card]').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${event.clientX - r.left}px`);
      card.style.setProperty('--my', `${event.clientY - r.top}px`);
    });
  });

  // FAQ: one topic on screen at a time. All answers remain in the page.
  const faq = document.querySelector<HTMLElement>('[data-faq]');
  if (faq) {
    const tabs = Array.from(faq.querySelectorAll<HTMLButtonElement>('[data-faq-tab]'));
    const panels = Array.from(faq.querySelectorAll<HTMLElement>('[data-faq-panel]'));
    const show = (id: string) => {
      tabs.forEach((tab) =>
        tab.setAttribute('aria-selected', String(tab.dataset.faqTab === id)),
      );
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.faqPanel !== id;
      });
    };
    faq.dataset.ready = '';
    show(tabs[0]?.dataset.faqTab ?? '');
    tabs.forEach((tab) => tab.addEventListener('click', () => show(tab.dataset.faqTab!)));
  }
</script>
