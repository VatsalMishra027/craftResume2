---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TemplateCard from '../components/TemplateCard.astro';
import TemplateThumb from '../components/TemplateThumb.astro';
import { TEMPLATES } from '../lib/templates';
import { BLUEPRINTS } from '../lib/blueprints';
import { LETTERS } from '../lib/letters';

/** Six layouts that span the range (ATS to creative); /templates holds the rest. */
const featuredIds = ['ledger', 'aperture', 'atlas', 'meridian', 'vertex', 'lattice'];
const featured = featuredIds.map((id) => TEMPLATES.find((t) => t.id === id)!).filter(Boolean);

const roleChips = [
  'Engineering',
  'Product',
  'Data',
  'Finance',
  'Marketing',
  'Design',
  'Healthcare',
  'Executive',
];

/** The hero stack turns through six layouts that look nothing like each other. */
const bookIds = ['atlas', 'ledger', 'cameo', 'vertex', 'cascade', 'orbit'];
const bookTemplates = bookIds.map((id) => TEMPLATES.find((t) => t.id === id)!).filter(Boolean);

const steps = [
  {
    n: '01',
    title: 'Pick a template',
    body: `${TEMPLATES.length} resume layouts, ${BLUEPRINTS.length} pre-filled role blueprints and ${LETTERS.length} cover letter formats. Swap between them at any point — your content stays put.`,
  },
  {
    n: '02',
    title: 'Fill in your details',
    body: 'A plain form on the left, your real resume on the right. Every keystroke shows up immediately, at full page size.',
  },
  {
    n: '03',
    title: 'Download the PDF',
    body: 'A4, selectable text, no watermark. It reads cleanly for a human and parses cleanly for an ATS.',
  },
];

const promises = [
  {
    title: 'No account, ever',
    body: 'No email, no password, no verification link. Open the editor and start typing.',
    icon: '<path d="M8 1.8 2.6 4.2v4c0 3.2 2.3 5.4 5.4 6.2 3.1-.8 5.4-3 5.4-6.2v-4z"/><path d="m5.8 8 1.6 1.6L10.4 6.4"/>',
  },
  {
    title: 'Stays on your machine',
    body: 'Your details are saved in your own browser. Nothing is uploaded to a server.',
    icon: '<rect x="2.2" y="7.2" width="11.6" height="6.6" rx="1.4"/><path d="M5 7.2V5a3 3 0 0 1 6 0v2.2"/>',
  },
  {
    title: 'Nothing is watermarked',
    body: 'The PDF carries your name and nothing else. No logo, no footer, no trial banner.',
    icon: '<path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z"/><path d="M9 1.8v3.6h3.6"/><path d="M5.9 9.4h4.2"/>',
  },
  {
    title: 'Real text, not a picture',
    body: 'The PDF is rendered as text, so applicant tracking systems can actually read it.',
    icon: '<path d="M3 4.2h10M5.6 4.2v8.4M2.4 12.6h6.4"/><path d="M10.4 8.6h3.2M12 8.6v4"/>',
  },
];

const faqGroups = [
  {
    id: 'free',
    label: 'Free & safe',
    items: [
      {
        q: 'Is it safe to use a resume builder?',
        a: 'It depends on where your data goes. Many online resume builders ask you to create an account and store your details on their servers. Free Resume Maker AI works differently: everything you type is saved in your own browser and is never uploaded, so there is no account to hack and nothing to delete later. Whichever builder you use, avoid putting a full home address, date of birth or ID numbers on a resume.',
      },
      {
        q: 'Is a resume maker safe?',
        a: 'A resume maker is as safe as its privacy model. Check whether it needs an account, whether it uploads your content and whether it sells your details. Here there is no sign-up and no upload, which makes it a safe free resume maker to use. On a shared computer, clear your browser data when you finish.',
      },
      {
        q: 'Which resume builder is 100% free?',
        a: 'Free Resume Maker AI is a resume builder that is completely free: every template, every colour and typeface option, unlimited PDF downloads, the cover letter editor and PDF import, with no watermark, no trial and no card. Be cautious with builders that let you design for free and then charge at the download step.',
      },
      {
        q: 'Does a resume builder make you pay?',
        a: 'Many do. A common pattern is to let you build the whole resume, then ask for a subscription when you try to download it. Not every builder works that way, and this one never does. You can build, edit and download as many times as you like without paying or entering a card.',
      },
      {
        q: 'Which CV maker is best?',
        a: 'The best CV maker is the one that gets a clean, readable document out of your head and into an employer’s inbox with the least friction. Look for a live preview at true page size, ATS-friendly layouts with real text, full control over colour and type, and a download that matches the preview with no paywall. That is the standard Free Resume Maker AI is built to meet.',
      },
      {
        q: 'What are the benefits of using a resume maker?',
        a: 'A resume maker handles layout, spacing and consistent formatting so you can focus on the content. You also get a sensible section order, templates that applicant tracking systems can parse, an instant preview as you type, and the ability to switch designs without retyping anything. It saves hours compared with formatting a document by hand.',
      },
    ],
  },
  {
    id: 'writing',
    label: 'Writing a strong resume',
    items: [
      {
        q: 'What are 10 tips for creating a strong resume?',
        a: '1. Tailor it to each job posting. 2. Lead with a short, specific summary. 3. Put your most relevant experience first. 4. Start bullets with strong action verbs. 5. Quantify results with numbers, percentages or scale. 6. Mirror keywords from the job description. 7. Keep the design clean and consistent. 8. Use standard section headings. 9. Cut anything old or irrelevant, usually beyond 10 to 15 years. 10. Proofread, then export a PDF with selectable text.',
      },
      {
        q: 'What is the 7 second rule for a CV?',
        a: 'Recruiters often make a first judgement in roughly six to seven seconds of scanning. In that time they look at your name, current title, recent employers, dates and headings. To pass the scan, put your strongest and most relevant information at the top, use clear headings and generous spacing, and keep bullets short enough to skim.',
      },
      {
        q: 'What are the 5 golden rules of resume writing?',
        a: 'Keep it relevant, concise, specific, honest and error-free. Relevant means tailored to the role. Concise means one or two pages with no filler. Specific means measurable results instead of vague duties. Honest means never inventing experience. Error-free means checking spelling, dates and contact details before you send it.',
      },
      {
        q: 'What skills should I list on a resume?',
        a: 'List skills that match the job posting, split into hard skills (tools, software, languages, certifications) and a few soft skills shown through your bullet points rather than claimed in a list. Keep the section short and honest, group related skills together, and use the exact wording of the posting where it is true for you, since ATS filters often match on keywords.',
      },
      {
        q: 'How should a 2026 CV look?',
        a: 'Clean and easy to scan: a clear name and title, a two to three line summary, reverse-chronological experience with quantified results, and a short skills section. Use a readable modern typeface at 10 to 11 pt, restrained colour, and a layout an ATS can read. Skip graphics and skill bars, and add a photo only if your country or industry expects one.',
      },
    ],
  },
  {
    id: 'format',
    label: 'Format & length',
    items: [
      {
        q: 'What resume format is best?',
        a: 'For most people the reverse-chronological format is best: it lists your newest role first and is the layout recruiters and applicant tracking systems expect. A functional format hides your timeline and often raises questions, while a combination format can help career changers who need to lead with skills.',
      },
      {
        q: 'Which type of resume is better?',
        a: 'Chronological suits steady career progression, functional suits very few cases such as long gaps, and combination suits career changers. If you are unsure, choose chronological. Within that, pick a single-column ATS-focused template for automated screens, or a two-column or creative layout when a person is likely to read it first.',
      },
      {
        q: 'What font is best for resumes?',
        a: 'Pick a clean, widely used typeface that stays legible at 10 to 12 pt, such as Inter, Calibri, Arial, Helvetica or Georgia. Use one family, or at most a serif and sans-serif pair. In the editor you can change the typeface and size on any template with a live preview.',
      },
      {
        q: 'How long should a CV be?',
        a: 'One page is right for students, graduates and anyone with under about ten years of experience. Two pages suit experienced professionals, managers and technical roles with many projects. Academic CVs can run longer. Whatever the length, every line should earn its place, and the last page should never hold just a few stray lines.',
      },
      {
        q: 'How many pages can a CV be?',
        a: 'In most industries a CV should be one or two pages. Three or more pages are normal only for academic, medical, research or senior executive CVs that list publications, qualifications or board roles. Check what the employer or country expects before you go beyond two.',
      },
      {
        q: 'Is a one or two page CV better?',
        a: 'Neither is better in general: use the shortest length that shows your relevant experience. A tight one-page resume is easier to scan and works well early in a career. A well-organised two-page resume is better once you have a longer track record. Never pad a short history to fill a second page, or squeeze a long one onto a single cramped page.',
      },
    ],
  },
  {
    id: 'using',
    label: 'Using the builder',
    items: [
      {
        q: 'Can I edit my resume online?',
        a: 'Yes. Open the editor in any modern browser, fill in the form and watch the resume update live at full page size. You can change templates, colours, typefaces, margins and spacing at any time, and your draft is saved automatically in your browser so you can return later.',
      },
      {
        q: 'How can I edit my old resume?',
        a: 'Use the Import resume page and upload your existing PDF. The builder reads it in your browser, sorts your roles, education and skills into the right sections and opens it in the editor, where you can update the content and switch to a fresh template. Nothing is uploaded to a server. If your old resume is a Word file, save it as a PDF first.',
      },
      {
        q: 'Can I create a CV on my phone?',
        a: 'Yes. The editor works on phones and tablets with an Edit and Preview toggle, so you can type your details and then check the page layout. Many people prefer a laptop for final tidying, but a complete resume can be built and saved from a phone.',
      },
      {
        q: 'Is Free Resume Maker AI really an AI resume builder?',
        a: 'The name says AI because that is how most people search for a resume maker, but to be straight with you, it does not write your resume with generative AI and it never invents experience you do not have. What it does is practical: it reads an existing PDF and fills in your sections automatically, guides your cover letter into three short blocks, and lays out anything you paste in, including bullet points drafted with an AI writing assistant.',
      },
    ],
  },
];

const faqs = faqGroups.flatMap((group) => group.items);

/** Structured data: the app itself, the site, and the visible FAQ above. */
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}#app`,
      name: 'Free Resume Maker AI',
      alternateName: ['freeresumemakerai.com', 'Free Resume Builder and Maker'],
      url: siteUrl,
      description:
        'Free resume builder and online resume maker with ATS-friendly templates, a live preview and free PDF download. No account needed.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any (web browser)',
      browserRequirements: 'Requires a modern web browser with JavaScript enabled.',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        `${TEMPLATES.length} resume templates`,
        `${BLUEPRINTS.length} pre-filled role blueprints`,
        `${LETTERS.length} cover letter formats`,
        'Free PDF download with no watermark',
        'Import an existing resume PDF',
        'No account or sign-up',
      ],
      image: new URL('/og-image.png', siteUrl).href,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Free Resume Maker AI',
      url: siteUrl,
      inLanguage: 'en',
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<Layout
  title="Free Resume Builder & Resume Maker — Download PDF | Free Resume Maker AI"
  description={`Free resume builder and online resume maker. Choose from ${TEMPLATES.length} ATS-friendly templates, fill in your details and download a PDF — no sign-up, no watermark.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-paper-sunk/70 to-transparent"
        aria-hidden="true"
      >
      </div>
      <div class="hero-glow" aria-hidden="true"></div>

      <div
        class="shell relative grid gap-14 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16 lg:py-24"
      >
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-xs text-ink-soft"
          >
            <span class="size-1.5 rounded-full bg-clay"></span>
            Free · No account · No watermark
          </p>

          <h1 class="display mt-6 text-[clamp(2.6rem,7vw,4.4rem)]">
            <span
              class="mb-3 block font-sans text-[clamp(0.85rem,1.6vw,1rem)] font-semibold uppercase tracking-[0.12em] text-clay"
              >Free resume builder &amp; resume maker</span
            >
            Craft a resume<br />
            <span class="text-gradient-clay font-serif font-normal italic tracking-[-0.01em]"
              >worth reading.</span
            >
          </h1>

          <p class="mt-6 max-w-lg text-[17px] leading-relaxed text-ink-soft">
            The free resume builder with nothing to pay for: choose a template, fill in your
            details and download your resume as a PDF. Need a cover letter too? Write it the same
            way, in matching colour and type. No sign-up wall, no credit card, and no free resume
            maker catch where the export quietly stamps a logo on your work.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href="/editor"
              class="inline-flex h-12 items-center rounded-full bg-ink px-7 text-[15px] font-medium text-paper transition-transform duration-200 ease-(--ease-out-soft) hover:-translate-y-0.5 active:translate-y-0"
            >
              Start building
            </a>
            <a
              href="/import"
              class="inline-flex h-12 items-center gap-2 rounded-full border border-clay/40 bg-clay-soft/40 px-6 text-[15px] font-medium text-clay transition-all duration-200 hover:bg-clay-soft hover:border-clay"
            >
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" class="size-4">
                <path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z" />
                <path d="M9 1.8v3.6h3.6M8 8v4m-2-2 2-2 2 2" />
              </svg>
              Import PDF resume
            </a>
            <a
              href="/templates"
              class="inline-flex h-12 items-center rounded-full border border-line-strong px-7 text-[15px] font-medium text-ink transition-colors duration-200 hover:bg-paper-sunk"
            >
              Browse templates
            </a>
            <a
              href="/cover-letter-templates"
              class="inline-flex h-12 items-center gap-2 rounded-full px-3 text-[15px] font-medium text-ink-soft transition-colors duration-200 hover:text-ink"
            >
              Write a cover letter
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-5 border-t border-line pt-7">
            <div>
              <dt class="eyebrow">Resume templates</dt>
              <dd class="mt-1 text-xl font-semibold tabular-nums">{TEMPLATES.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">Letter formats</dt>
              <dd class="mt-1 text-xl font-semibold tabular-nums">{LETTERS.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">Role blueprints</dt>
              <dd class="mt-1 text-xl font-semibold tabular-nums">{BLUEPRINTS.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">Downloads</dt>
              <dd class="mt-1 text-xl font-semibold">Unlimited</dd>
            </div>
            <div>
              <dt class="eyebrow">Resume data leaves your device</dt>
              <dd class="mt-1 text-xl font-semibold">Never</dd>
            </div>
          </dl>
        </div>

        <!-- Layered preview: the real renderer, not a screenshot. The stack
             turns itself, a page at a time, through four of the templates. -->
        <div class="relative mx-auto w-full max-w-[380px] pb-10 lg:max-w-[440px]">
          <button
            type="button"
            data-book
            aria-label="Turn to the next template"
            class="book block w-[88%] cursor-pointer focus-visible:outline-none"
            style="aspect-ratio: 210 / 297"
          >
            {
              bookTemplates.map((template, index) => (
                <span
                  class="book-page"
                  data-book-page
                  data-name={template.name}
                  data-state={index === 0 ? 'front' : 'stack'}
                  style={`--depth:${index}`}
                >
                  <TemplateThumb templateId={template.id} />
                </span>
              ))
            }
          </button>

          <p class="book-caption text-xs text-ink-muted">
            <span class="font-medium text-ink" data-book-caption>{bookTemplates[0].name}</span>
            <span class="text-ink-faint">
              &nbsp;·&nbsp;<span class="book-count" data-book-count
                >1 / {bookTemplates.length}</span
              >&nbsp;·&nbsp;tap to turn
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="scroll-mt-20 border-t border-line bg-surface/60">
      <div class="shell py-20">
        <p class="eyebrow">How it works</p>
        <h2 class="display mt-3 max-w-2xl text-[clamp(1.9rem,4vw,2.7rem)]">
          Three steps. Roughly ten minutes.
        </h2>

        <ol class="mt-14 grid gap-4 md:grid-cols-3">
          {
            steps.map((step) => (
              <li class="step-card glass glass-edge rounded-card p-7">
                <span class="step-number" aria-hidden="true">
                  {step.n}
                </span>
                <h3 class="mt-1 text-lg font-semibold tracking-[-0.015em]">{step.title}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-ink-muted">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Templates -->
    <section class="border-t border-line">
      <div class="shell py-20">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="eyebrow">Templates</p>
            <h2 class="display mt-3 max-w-xl text-[clamp(1.9rem,4vw,2.7rem)]">
              {TEMPLATES.length} free resume templates, no filler.
            </h2>
            <p class="mt-4 max-w-lg text-ink-muted">
              Six of our best free resume maker layouts, from ATS-friendly to creative. Every
              preview is the live template rendering real content, so what you see is exactly what
              prints.
            </p>
          </div>
          <a
            href="/templates"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-ink underline-offset-4 hover:underline"
          >
            Browse all {TEMPLATES.length} templates
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((template) => <TemplateCard template={template} />)}
        </div>

        <div class="fast-start mt-14">
          <div class="relative grid items-center gap-8 p-8 sm:p-10 lg:grid-cols-[1.2fr_0.8fr]">
            <div>
              <p class="fs-kicker">
                <span class="fs-pulse" aria-hidden="true"></span>
                Fast start
              </p>
              <h3 class="display mt-4 text-[clamp(1.5rem,3vw,2.1rem)]">
                Skip the blank page. <span class="fs-accent">Start from a finished resume.</span>
              </h3>
              <p class="mt-3 max-w-lg text-sm leading-relaxed text-ink-muted">
                {BLUEPRINTS.length} role blueprints, each written for a real job and ready to edit.
                Swap in your own details instead of staring at an empty form — a faster way to build
                a resume for free.
              </p>
              <a href="/templates?tab=roles" class="fs-button mt-7">
                <span>See the blueprints</span>
                <span class="fs-arrow" aria-hidden="true">→</span>
              </a>
            </div>

            <ul class="fs-chips" aria-label="Role blueprints available">
              {
                roleChips.map((chip, i) => (
                  <li style={`--i:${i}`}>
                    <a href="/templates?tab=roles">{chip}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Promises -->
    <section class="promise-section relative overflow-hidden border-t border-line" data-promises>
      <div class="promise-bg" aria-hidden="true"></div>
      <div class="shell relative py-24">
        <div class="flex flex-wrap items-end justify-between gap-8">
          <div>
            <p class="eyebrow">What you get</p>
            <h2 class="display mt-3 max-w-2xl text-[clamp(1.9rem,4vw,2.7rem)]">
              The parts other builders <span class="promise-strike">charge for.</span>
            </h2>
          </div>

          <div class="promise-price" aria-label="Your cost for all of it: zero, forever">
            <span class="pp-label">Your cost for all of it</span>
            <span class="pp-amount">$0</span>
            <span class="pp-note">today, tomorrow, forever</span>
          </div>
        </div>

        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            promises.map((item, index) => (
              <article class="promise-card" style={`--i:${index}`} data-promise-card>
                <span class="promise-bar" aria-hidden="true" />
                <span class="promise-num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="promise-icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-[1.2rem]"
                    set:html={item.icon}
                  />
                </span>
                <h3 class="relative mt-6 text-[15px] font-semibold tracking-[-0.01em]">
                  {item.title}
                </h3>
                <p class="relative mt-2 text-sm leading-relaxed text-ink-muted">{item.body}</p>
                <span class="promise-chip">
                  <svg viewBox="0 0 12 12" fill="none" class="size-3" aria-hidden="true">
                    <path
                      d="m2.5 6.2 2.2 2.2 4.8-4.8"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  Included free
                </span>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- About the tool: long-form copy for readers who want the detail (and for search). -->
    <section id="about" class="scroll-mt-20 border-t border-line">
      <div class="shell grid gap-12 py-20 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <p class="eyebrow">About Free Resume Maker AI</p>
          <h2 class="display mt-3 text-[clamp(1.9rem,4vw,2.7rem)]">
            A free resume builder that respects your time.
          </h2>
          <a
            href="/editor"
            class="mt-8 inline-flex h-11 items-center rounded-full bg-ink px-6 text-sm font-medium text-paper transition-transform duration-200 ease-(--ease-out-soft) hover:-translate-y-0.5"
          >
            Make my resume free
          </a>
        </div>

        <article class="seo-copy">
          <p>
            Free Resume Maker AI is a free resume builder and online resume maker for people who want a
            polished, professional resume without the usual catches. Choose from {TEMPLATES.length} templates, type
            your details into a simple form and watch the page update live. When it
            looks right, download a clean PDF. There is no sign-up wall, no credit card, no trial that
            expires halfway through, and no watermark stamped across the bottom of your page.
          </p>

          <h3>A resume builder free in every sense</h3>
          <p>
            Plenty of tools describe themselves as a resume builder free of charge, then ask for payment
