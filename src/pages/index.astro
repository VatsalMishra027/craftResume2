<style>
  /* --- How it works -------------------------------------------------------
     The step markers used to be 12px of monospace, which read as a footnote
     rather than as the thing numbering the steps. They are now the largest
     element in the card: Space Grotesk at display size, cut off at the
     baseline by the card's own edge so the numerals feel set into the panel
     rather than typed onto it.
  --------------------------------------------------------------------------- */
  .step-card {
    position: relative;
    overflow: hidden;
    transition:
      transform 300ms var(--ease-out-soft),
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .step-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-lift);
  }

  .step-number {
    display: block;
    font-family: var(--font-numeral);
    font-size: clamp(2.75rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
    font-variant-numeric: tabular-nums lining-nums;
    background: linear-gradient(
      160deg,
      var(--color-clay),
      color-mix(in srgb, var(--color-clay) 45%, var(--color-ink))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* A second, much fainter copy of the numeral sitting behind the card's
     corner. It is what stops the panel reading as a flat rectangle. */
  .step-card::after {
    content: "";
    position: absolute;
    right: -1.5rem;
    bottom: -3.5rem;
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 30%,
      color-mix(in srgb, var(--color-clay) 14%, transparent),
      transparent 70%
    );
    pointer-events: none;
    transition: opacity 300ms ease;
    opacity: 0.9;
  }

  .step-card:hover::after {
    opacity: 1;
  }

  /* --- What you get ------------------------------------------------------- */
  .promise-section {
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
  }

  /* A faint ruled-paper grid with one warm glow — texture, not decoration. */
  .promise-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        60% 70% at 85% 0%,
        color-mix(in srgb, var(--color-clay) 13%, transparent),
        transparent 70%
      ),
      linear-gradient(to right, color-mix(in srgb, var(--color-line) 55%, transparent) 1px, transparent 1px)
        0 0 / 48px 48px,
      linear-gradient(to bottom, color-mix(in srgb, var(--color-line) 55%, transparent) 1px, transparent 1px)
        0 0 / 48px 48px;
    -webkit-mask-image: radial-gradient(90% 80% at 50% 30%, #000 30%, transparent 85%);
    mask-image: radial-gradient(90% 80% at 50% 30%, #000 30%, transparent 85%);
  }

  /* "charge for." gets a clay line struck through it — they charge, we don't. */
  .promise-strike {
    position: relative;
    white-space: nowrap;
  }

  .promise-strike::after {
    content: '';
    position: absolute;
    left: -2%;
    right: -2%;
    top: 54%;
    height: 0.11em;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-clay), #e8855a);
    transform: rotate(-3deg) scaleX(var(--strike, 1));
    transform-origin: left center;
    transition: transform 700ms cubic-bezier(0.6, 0, 0.2, 1) 200ms;
  }

  [data-promises][data-reveal='pending'] .promise-strike::after {
    --strike: 0;
  }

  .promise-price {
    display: grid;
    justify-items: end;
    text-align: right;
  }

  .pp-label,
  .pp-note {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .pp-amount {
