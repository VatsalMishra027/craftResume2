---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TemplateCard from '../components/TemplateCard.astro';
import TemplateThumb from '../components/TemplateThumb.astro';
import { TEMPLATES, TEMPLATE_CATEGORIES } from '../lib/templates';
import { BLUEPRINTS } from '../lib/blueprints';
import { LETTERS } from '../lib/letters';

/** One layout per shelf, so the grid shows the range without printing all 12. */
const featured = TEMPLATE_CATEGORIES.map(
  (category) => TEMPLATES.find((template) => template.category === category)!,
).filter(Boolean);

/** The hero stack turns through six layouts that look nothing like each other. */
const bookIds = ['atlas', 'ledger', 'cameo', 'vertex', 'cascade', 'orbit'];
const bookTemplates = bookIds.map((id) => TEMPLATES.find((t) => t.id === id)!).filter(Boolean);

const steps = [
  {
    n: '01',
    title: 'Pick a template',
    body: `${TEMPLATES.length} resume layouts, ${BLUEPRINTS.length} pre-filled role blueprints and ${LETTERS.length} cover letter formats. Swap between them at any point — your content stays put.`,
  },
  {
    n: '02',
    title: 'Fill in your details',
    body: 'A plain form on the left, your real resume on the right. Every keystroke shows up immediately, at full page size.',
  },
  {
    n: '03',
    title: 'Download the PDF',
    body: 'A4, selectable text, no watermark. It reads cleanly for a human and parses cleanly for an ATS.',
  },
];

const promises = [
  {
    title: 'No account, ever',
    body: 'No email, no password, no verification link. Open the editor and start typing.',
    icon: '<path d="M8 1.8 2.6 4.2v4c0 3.2 2.3 5.4 5.4 6.2 3.1-.8 5.4-3 5.4-6.2v-4z"/><path d="m5.8 8 1.6 1.6L10.4 6.4"/>',
  },
  {
    title: 'Stays on your machine',
    body: 'Your details are saved in your own browser. Nothing is uploaded to a server.',
    icon: '<rect x="2.2" y="7.2" width="11.6" height="6.6" rx="1.4"/><path d="M5 7.2V5a3 3 0 0 1 6 0v2.2"/>',
  },
  {
    title: 'Nothing is watermarked',
    body: 'The PDF carries your name and nothing else. No logo, no footer, no trial banner.',
    icon: '<path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z"/><path d="M9 1.8v3.6h3.6"/><path d="M5.9 9.4h4.2"/>',
  },
  {
    title: 'Real text, not a picture',
    body: 'The PDF is rendered as text, so applicant tracking systems can actually read it.',
    icon: '<path d="M3 4.2h10M5.6 4.2v8.4M2.4 12.6h6.4"/><path d="M10.4 8.6h3.2M12 8.6v4"/>',
  },
];

const faqs = [
  {
    q: 'Is CraftResume really free?',
    a: 'Yes. Every template and unlimited downloads, with no watermark and no card required. There is no paid tier to upsell you to.',
  },
  {
    q: 'Do I need to create an account?',
    a: 'No. Your resume is stored in your browser, so you can close the tab and pick it up later on the same device. Clearing your browser data clears the resume too.',
  },
  {
    q: 'Are the templates ATS friendly?',
    a: `All ${TEMPLATES.length} use standard section headings, real text and a single reading order, and each card tells you how strictly it parses. Ledger, Beacon and Meridian are the safest bets when you know the application goes through an automated screen.`,
  },
  {
    q: 'How does the download work?',
    a: 'Download opens your print dialog with the resume already isolated on an A4 page. Choose “Save as PDF” and you get a clean, selectable-text file.',
  },
  {
    q: 'Can I download my resume as a PDF for free?',
    a: 'Yes. Every download is free and unlimited, with no watermark. You can also export a Word file or copy the plain text if an application form asks for it.',
  },
  {
    q: 'Is CraftResume an AI resume builder?',
    a: 'Not in the sense of writing your resume for you — it never invents experience. It reads an existing PDF and fills in your sections automatically, guides your cover letter into three short blocks, and lays out anything you paste in, including bullet points drafted with an AI writing assistant.',
  },
];

/** Structured data: the app itself, the site, and the visible FAQ above. */
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}#app`,
      name: 'CraftResume',
      alternateName: 'CraftResume Free Resume Builder',
      url: siteUrl,
      description:
        'Free resume builder and online resume maker with ATS-friendly templates, a live preview and free PDF download. No account needed.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any (web browser)',
      browserRequirements: 'Requires a modern web browser with JavaScript enabled.',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        `${TEMPLATES.length} resume templates`,
        `${BLUEPRINTS.length} pre-filled role blueprints`,
        `${LETTERS.length} cover letter formats`,
        'Free PDF download with no watermark',
        'Import an existing resume PDF',
        'No account or sign-up',
      ],
      image: new URL('/og-image.png', siteUrl).href,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'CraftResume',
      url: siteUrl,
      inLanguage: 'en',
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<Layout
  title="Free Resume Builder & Resume Maker — Download PDF | CraftResume"
  description={`Free resume builder and online resume maker. Choose from ${TEMPLATES.length} ATS-friendly templates, fill in your details and download a PDF — no sign-up, no watermark.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-paper-sunk/70 to-transparent"
        aria-hidden="true"
      >
      </div>
      <div class="hero-glow" aria-hidden="true"></div>

      <div
        class="shell relative grid gap-14 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16 lg:py-24"
      >
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-xs text-ink-soft"
          >
            <span class="size-1.5 rounded-full bg-clay"></span>
            Free · No account · No watermark
          </p>

          <h1 class="display mt-6 text-[clamp(2.6rem,7vw,4.4rem)]">
            <span
              class="mb-3 block font-sans text-[clamp(0.85rem,1.6vw,1rem)] font-semibold uppercase tracking-[0.12em] text-clay"
              >Free resume builder &amp; resume maker</span
            >
            Craft a resume<br />
            <span class="text-gradient-clay font-serif font-normal italic tracking-[-0.01em]"
              >worth reading.</span
            >
          </h1>

          <p class="mt-6 max-w-lg text-[17px] leading-relaxed text-ink-soft">
            Choose a template, fill in your details, download the PDF. Then, if the posting asks for
            one, write the cover letter the same way — its own formats, its own editor, the same
            colour and type. No sign-up wall, no credit card, no export that quietly stamps a logo
            on your work.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href="/editor"
              class="inline-flex h-12 items-center rounded-full bg-ink px-7 text-[15px] font-medium text-paper transition-transform duration-200 ease-(--ease-out-soft) hover:-translate-y-0.5 active:translate-y-0"
            >
              Start building
            </a>
            <a
              href="/import"
              class="inline-flex h-12 items-center gap-2 rounded-full border border-clay/40 bg-clay-soft/40 px-6 text-[15px] font-medium text-clay transition-all duration-200 hover:bg-clay-soft hover:border-clay"
            >
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" class="size-4">
                <path d="M9 1.8H4.4a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7.2a1 1 0 0 0 1-1V5.4z" />
                <path d="M9 1.8v3.6h3.6M8 8v4m-2-2 2-2 2 2" />
              </svg>
              Import PDF resume
            </a>
            <a
              href="/templates"
              class="inline-flex h-12 items-center rounded-full border border-line-strong px-7 text-[15px] font-medium text-ink transition-colors duration-200 hover:bg-paper-sunk"
            >
              Browse templates
            </a>
            <a
              href="/cover-letter-templates"
              class="inline-flex h-12 items-center gap-2 rounded-full px-3 text-[15px] font-medium text-ink-soft transition-colors duration-200 hover:text-ink"
            >
              Write a cover letter
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-5 border-t border-line pt-7">
            <div>
              <dt class="eyebrow">Resume templates</dt>
              <dd class="mt-1 text-xl font-semibold tabular-nums">{TEMPLATES.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">Letter formats</dt>
              <dd class="mt-1 text-xl font-semibold tabular-nums">{LETTERS.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">Role blueprints</dt>
              <dd class="mt-1 text-xl font-semibold tabular-nums">{BLUEPRINTS.length}</dd>
            </div>
            <div>
              <dt class="eyebrow">Downloads</dt>
              <dd class="mt-1 text-xl font-semibold">Unlimited</dd>
            </div>
            <div>
              <dt class="eyebrow">Data leaves your device</dt>
              <dd class="mt-1 text-xl font-semibold">Never</dd>
            </div>
          </dl>
        </div>

        <!-- Layered preview: the real renderer, not a screenshot. The stack
             turns itself, a page at a time, through four of the templates. -->
        <div class="relative mx-auto w-full max-w-[380px] pb-10 lg:max-w-[440px]">
          <button
            type="button"
            data-book
            aria-label="Turn to the next template"
            class="book block w-[88%] cursor-pointer focus-visible:outline-none"
            style="aspect-ratio: 210 / 297"
          >
            {
              bookTemplates.map((template, index) => (
                <span
                  class="book-page"
                  data-book-page
                  data-name={template.name}
                  data-state={index === 0 ? 'front' : 'stack'}
                  style={`--depth:${index}`}
                >
                  <TemplateThumb templateId={template.id} />
                </span>
              ))
            }
          </button>

          <p class="book-caption text-xs text-ink-muted">
            <span class="font-medium text-ink" data-book-caption>{bookTemplates[0].name}</span>
            <span class="text-ink-faint">
              &nbsp;·&nbsp;<span class="book-count" data-book-count
                >1 / {bookTemplates.length}</span
              >&nbsp;·&nbsp;tap to turn
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="scroll-mt-20 border-t border-line bg-surface/60">
      <div class="shell py-20">
        <p class="eyebrow">How it works</p>
        <h2 class="display mt-3 max-w-2xl text-[clamp(1.9rem,4vw,2.7rem)]">
          Three steps. Roughly ten minutes.
        </h2>

        <ol class="mt-14 grid gap-4 md:grid-cols-3">
          {
            steps.map((step) => (
              <li class="step-card glass glass-edge rounded-card p-7">
                <span class="step-number" aria-hidden="true">
                  {step.n}
                </span>
                <h3 class="mt-1 text-lg font-semibold tracking-[-0.015em]">{step.title}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-ink-muted">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Templates -->
    <section class="border-t border-line">
      <div class="shell py-20">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="eyebrow">Templates</p>
            <h2 class="display mt-3 max-w-xl text-[clamp(1.9rem,4vw,2.7rem)]">
              {TEMPLATES.length} layouts, no filler.
            </h2>
            <p class="mt-4 max-w-md text-ink-muted">
              One from each shelf below — ATS-focused through creative. Every preview is the live
              template rendering real content, so what you see is exactly what prints.
            </p>
          </div>
          <a
            href="/templates"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-ink underline-offset-4 hover:underline"
          >
            See them full size
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((template) => <TemplateCard template={template} />)}
        </div>

        <div
          class="mt-14 flex flex-col items-start justify-between gap-5 rounded-card border border-line bg-surface p-7 sm:flex-row sm:items-center"
        >
          <div>
            <p class="eyebrow">Fast start</p>
            <h3 class="mt-2 text-lg font-semibold tracking-[-0.015em]">
              Or open one already written for your job.
            </h3>
            <p class="mt-1.5 max-w-lg text-sm leading-relaxed text-ink-muted">
              {BLUEPRINTS.length} role blueprints — engineering, product, data, finance, marketing,
              design, healthcare and executive — each arriving as a finished resume you edit over
              instead of an empty form.
            </p>
          </div>
          <a
            href="/templates?tab=roles"
            class="inline-flex h-11 flex-none items-center rounded-full border border-line-strong px-6 text-sm font-medium text-ink transition-colors duration-200 hover:bg-paper-sunk"
          >
            See the blueprints
          </a>
        </div>
      </div>
    </section>

    <!-- Promises -->
    <section class="promise-section relative overflow-hidden border-t border-line" data-promises>
      <div class="promise-bg" aria-hidden="true"></div>
      <div class="shell relative py-24">
        <div class="flex flex-wrap items-end justify-between gap-8">
          <div>
            <p class="eyebrow">What you get</p>
            <h2 class="display mt-3 max-w-2xl text-[clamp(1.9rem,4vw,2.7rem)]">
              The parts other builders <span class="promise-strike">charge for.</span>
            </h2>
          </div>

          <div class="promise-price" aria-label="Your cost for all of it: zero, forever">
            <span class="pp-label">Your cost for all of it</span>
            <span class="pp-amount">$0</span>
            <span class="pp-note">today, tomorrow, forever</span>
          </div>
        </div>

        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            promises.map((item, index) => (
              <article class="promise-card" style={`--i:${index}`} data-promise-card>
                <span class="promise-bar" aria-hidden="true" />
                <span class="promise-num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="promise-icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-[1.2rem]"
                    set:html={item.icon}
                  />
                </span>
                <h3 class="relative mt-6 text-[15px] font-semibold tracking-[-0.01em]">
                  {item.title}
                </h3>
                <p class="relative mt-2 text-sm leading-relaxed text-ink-muted">{item.body}</p>
                <span class="promise-chip">
                  <svg viewBox="0 0 12 12" fill="none" class="size-3" aria-hidden="true">
                    <path
                      d="m2.5 6.2 2.2 2.2 4.8-4.8"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  Included free
                </span>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- About the tool: long-form copy for readers who want the detail (and for search). -->
    <section id="about" class="scroll-mt-20 border-t border-line">
      <div class="shell grid gap-12 py-20 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <p class="eyebrow">About CraftResume</p>
          <h2 class="display mt-3 text-[clamp(1.9rem,4vw,2.7rem)]">
            A free resume builder that respects your time.
          </h2>
          <a
            href="/editor"
            class="mt-8 inline-flex h-11 items-center rounded-full bg-ink px-6 text-sm font-medium text-paper transition-transform duration-200 ease-(--ease-out-soft) hover:-translate-y-0.5"
          >
            Make my resume free
          </a>
        </div>

        <article class="seo-copy">
          <p>
            CraftResume is a free resume builder and online resume maker for people who want a
            polished, professional resume without the usual catches. Choose from {TEMPLATES.length} templates, type
            your details into a simple form and watch the page update live. When it
            looks right, download a clean PDF. There is no sign-up wall, no credit card, no trial that
            expires halfway through, and no watermark stamped across the bottom of your page.
          </p>

          <h3>A resume builder free in every sense</h3>
          <p>
            Plenty of tools describe themselves as a resume builder free of charge, then ask for payment
            the moment you try to download. CraftResume works the other way round. Every template, every
            colour and every export is included, and you can download your resume as many times as you
            like. It is a free resume maker in the plain sense of the word: you build the resume, you
            keep the file, and nothing is held back for a paid tier because there isn't one. If you
            need a resume maker free of hidden costs, you can stop looking.
          </p>

          <h3>Online resume maker with a free PDF download</h3>
          <p>
            CraftResume runs in your browser, so it works as an online resume maker on any laptop or
            desktop with nothing to install. The download produces a true A4 PDF with selectable text,
            which means recruiters can copy your details and applicant tracking systems can read every
            word. If you have been searching for an online resume maker free PDF download that does not
            turn your resume into a blurry image, this is exactly the problem it was built to solve.
            Using the free resume builder and download takes a few clicks, all in one place.
          </p>

          <h3>Templates for every kind of job</h3>
          <p>
            The template gallery covers ATS-focused single-column layouts for finance, law and
            government applications, modern two-column designs for engineering and data roles, executive
            layouts for senior positions, academic formats for researchers and teachers, creative
            designs for designers and marketers, and five layouts with space for a professional photo.
            Each template shows who it suits best and how safely it parses in an applicant tracking
            system, so choosing is quick. You can switch templates at any time and your content moves
            with you, so trying a new look costs nothing.
          </p>

          <h3>Role blueprints and matching cover letters</h3>
          <p>
            Not sure what to write? Start from one of {BLUEPRINTS.length} role blueprints — complete
            example resumes for engineering, product, data, finance, marketing and more — and replace the
            sample details with your own. When a job asks for a cover letter, the same resume maker
            includes a cover letter editor with {LETTERS.length} formats. It borrows your resume's colour
            and typeface, so your application arrives looking like one consistent document.
          </p>

          <h3>Looking for an AI resume builder?</h3>
          <p>
            Many people search for an AI resume builder or an AI resume maker, hoping a tool will do the
            hard part for them. CraftResume takes a practical approach: it never invents experience you
            do not have, and instead gives you structure that makes good writing easier. Import an
            existing PDF and the builder reads it automatically, sorting your roles, education and skills
            into the right sections. The cover letter editor breaks the letter into three guided blocks,
            and a live length meter tells you when it is the right size. If you like to draft bullet
            points with an AI writing assistant, paste them straight in — CraftResume works well
            alongside any resume builder AI tool and lays the result out properly. And unlike many "AI
            resume builder free" trials, nothing here is locked behind a subscription.
          </p>

          <h3>Built for applicant tracking systems</h3>
          <p>
            Most large employers filter applications with an applicant tracking system before a person
            ever reads them, and a resume that looks beautiful but parses badly can disappear at this
            stage. Every CraftResume template uses standard section headings, real text and a single
            reading order, and the photo layouts keep the headshot out of the text so parsers are never
            confused. The result is a resume that reads cleanly for a human and scans cleanly for
            software.
          </p>

          <h3>Private by design</h3>
          <p>
            Your resume holds personal details, so CraftResume keeps them on your device. Everything you
            type is saved in your own browser and is never uploaded to a server. There is no account to
            create and no data to delete later. Close the tab, come back tomorrow on the same device, and
            your draft is waiting. Clear everything by mistake and an undo option brings it back.
          </p>

          <h3>Is it the best free resume builder for you?</h3>
          <p>
            The best resume builder is the one that gets a strong resume out of your head and into an
            employer's inbox with the least friction. CraftResume focuses on the details that matter: a
            live preview at true page size, layouts that hold a full career on one page, control over
            colour, typeface, margins and spacing, and a download that looks exactly like the preview.
            Those details make it a strong candidate for the best free resume builder for everyday job
            hunting — whether you are a student writing a first resume, a professional changing careers or
            an executive updating a long record.
          </p>

          <h3>How to make your resume in minutes</h3>
          <ol>
            <li>Open the editor — there is nothing to sign up for.</li>
            <li>Pick a template, or start from a role blueprint.</li>
            <li>Fill in your experience, education and skills; the preview updates as you type.</li>
            <li>Adjust the colour, typeface and spacing until it feels like yours.</li>
            <li>Download your resume as a PDF and start applying.</li>
          </ol>
          <p>
            Using a resume builder for free should not mean settling for a worse resume. Start building
            now and you can have a finished, professional PDF in about ten minutes.
          </p>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="scroll-mt-20 border-t border-line">
      <div class="shell grid gap-12 py-20 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2 class="display mt-3 text-[clamp(1.9rem,4vw,2.7rem)]">Reasonable questions.</h2>
        </div>

        <div class="divide-y divide-line border-y border-line">
          {
            faqs.map((faq) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[15px] font-medium">
                  {faq.q}
                  <span
                    class="grid size-6 flex-none place-items-center rounded-full border border-line text-ink-muted transition-transform duration-300 ease-(--ease-out-soft) group-open:rotate-45"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 12 12" class="size-3" fill="none">
                      <path
                        d="M6 2v8M2 6h8"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                      />
                    </svg>
                  </span>
                </summary>
                <p class="mt-3 max-w-2xl pr-12 text-sm leading-relaxed text-ink-muted">{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="border-t border-line">
      <div class="shell py-20">
        <div class="cta-card rounded-card px-8 py-16 text-center sm:px-16">
          {/* The space before "away" is written as a non-breaking space on
              purpose: Astro trims the whitespace around a line break between
              an element and the text after it, which closed the gap up. */}
          <h2 class="display mx-auto max-w-3xl text-[clamp(2.2rem,5.2vw,3.5rem)]">
            Your next resume is about <span class="font-serif font-normal italic">ten minutes</span
            >&nbsp;away.
          </h2>
          <p class="cta-sub mx-auto mt-5 max-w-md text-[15px] leading-relaxed">
            No account. No card. Close the tab whenever you like — your draft will be here.
          </p>
          <a
            href="/editor"
            class="cta-button mt-9 inline-flex h-12 items-center rounded-full px-8 text-[15px] font-medium transition-transform duration-200 ease-(--ease-out-soft) hover:-translate-y-0.5 active:translate-y-0"
          >
            Start building
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* --- How it works -------------------------------------------------------
     The step markers used to be 12px of monospace, which read as a footnote
     rather than as the thing numbering the steps. They are now the largest
     element in the card: Space Grotesk at display size, cut off at the
     baseline by the card's own edge so the numerals feel set into the panel
     rather than typed onto it.
  --------------------------------------------------------------------------- */
  .step-card {
    position: relative;
    overflow: hidden;
    transition:
      transform 300ms var(--ease-out-soft),
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .step-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-lift);
  }

  .step-number {
    display: block;
    font-family: var(--font-numeral);
    font-size: clamp(2.75rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
    font-variant-numeric: tabular-nums lining-nums;
    background: linear-gradient(
      160deg,
      var(--color-clay),
      color-mix(in srgb, var(--color-clay) 45%, var(--color-ink))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* A second, much fainter copy of the numeral sitting behind the card's
     corner. It is what stops the panel reading as a flat rectangle. */
  .step-card::after {
    content: "";
    position: absolute;
    right: -1.5rem;
    bottom: -3.5rem;
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 30%,
      color-mix(in srgb, var(--color-clay) 14%, transparent),
      transparent 70%
    );
    pointer-events: none;
    transition: opacity 300ms ease;
    opacity: 0.9;
  }

  .step-card:hover::after {
    opacity: 1;
  }

  /* --- What you get ------------------------------------------------------- */
  .promise-section {
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
  }

  /* A faint ruled-paper grid with one warm glow — texture, not decoration. */
  .promise-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        60% 70% at 85% 0%,
        color-mix(in srgb, var(--color-clay) 13%, transparent),
        transparent 70%
      ),
      linear-gradient(to right, color-mix(in srgb, var(--color-line) 55%, transparent) 1px, transparent 1px)
        0 0 / 48px 48px,
      linear-gradient(to bottom, color-mix(in srgb, var(--color-line) 55%, transparent) 1px, transparent 1px)
        0 0 / 48px 48px;
    -webkit-mask-image: radial-gradient(90% 80% at 50% 30%, #000 30%, transparent 85%);
    mask-image: radial-gradient(90% 80% at 50% 30%, #000 30%, transparent 85%);
  }

  /* "charge for." gets a clay line struck through it — they charge, we don't. */
  .promise-strike {
    position: relative;
    white-space: nowrap;
  }

  .promise-strike::after {
    content: '';
    position: absolute;
    left: -2%;
    right: -2%;
    top: 54%;
    height: 0.11em;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-clay), #e8855a);
    transform: rotate(-3deg) scaleX(var(--strike, 1));
    transform-origin: left center;
    transition: transform 700ms cubic-bezier(0.6, 0, 0.2, 1) 200ms;
  }

  [data-promises][data-reveal='pending'] .promise-strike::after {
    --strike: 0;
  }

  .promise-price {
    display: grid;
    justify-items: end;
    text-align: right;
  }

  .pp-label,
  .pp-note {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .pp-amount {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3.2rem, 7vw, 4.6rem);
    line-height: 1;
    margin: 0.15rem 0 0.25rem;
    background: linear-gradient(120deg, var(--color-clay), #e8855a 55%, #f0a070);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .promise-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 1.625rem 1.5rem 1.375rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--color-surface) 92%, var(--color-clay)) 0%,
        var(--color-surface) 45%
      );
    box-shadow: 0 1px 2px rgb(22 21 15 / 0.04);
    transition:
      transform 350ms var(--ease-out-soft),
      border-color 300ms ease,
      box-shadow 350ms ease,
      opacity 600ms ease;
  }

  /* A soft clay spotlight that follows the pointer across the card. */
  .promise-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      220px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--color-clay) 16%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .promise-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--color-clay) 35%, var(--color-line-strong));
    box-shadow:
      0 2px 4px rgb(22 21 15 / 0.05),
      0 24px 48px -24px color-mix(in srgb, var(--color-clay) 45%, rgb(22 21 15 / 0.35));
  }

  .promise-card:hover::after {
    opacity: 1;
  }

  /* A clay rule along the top edge that draws across on hover. */
  .promise-bar {
    position: absolute;
    left: 1.5rem;
    top: 0;
    width: 1.75rem;
    height: 2px;
    border-radius: 0 0 2px 2px;
    background: linear-gradient(90deg, var(--color-clay), #f0a070);
    transition:
      width 450ms var(--ease-out-soft),
      left 450ms var(--ease-out-soft);
  }

  .promise-card:hover .promise-bar {
    left: 0;
    width: 100%;
  }

  .promise-num {
    position: absolute;
    right: 1.25rem;
    top: 0.9rem;
    font-family: var(--font-numeral);
    font-size: 2.6rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-line-strong);
    transition:
      -webkit-text-stroke-color 300ms ease,
      transform 400ms var(--ease-out-soft);
  }

  .promise-card:hover .promise-num {
    -webkit-text-stroke-color: color-mix(in srgb, var(--color-clay) 60%, transparent);
    transform: translateY(-2px);
  }

  .promise-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.875rem;
    color: var(--color-clay);
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-clay-soft) 100%, transparent),
        color-mix(in srgb, var(--color-clay) 14%, var(--color-surface))
      );
    border: 1px solid color-mix(in srgb, var(--color-clay) 24%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    transition:
      transform 400ms cubic-bezier(0.3, 1.5, 0.5, 1),
      box-shadow 300ms ease;
  }

  .promise-card:hover .promise-icon {
    transform: translateY(-2px) rotate(-6deg);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 10px 22px -8px color-mix(in srgb, var(--color-clay) 60%, transparent);
  }

  .promise-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 1.125rem;
    padding: 0.2rem 0.6rem 0.2rem 0.45rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-clay) 22%, transparent);
    background: color-mix(in srgb, var(--color-clay) 7%, transparent);
    color: var(--color-clay);
    font-size: 11px;
    font-weight: 600;
  }

  /* Cards rise in one after another the first time the section is seen. */
  [data-promises][data-reveal='pending'] .promise-card {
    opacity: 0;
    transform: translateY(18px);
  }

  [data-promises] .promise-card {
    transition-delay: calc(var(--i, 0) * 90ms), 0ms, 0ms, calc(var(--i, 0) * 90ms);
  }

  [data-promises] .promise-card:hover {
    transition-delay: 0ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .promise-card,
    .promise-bar,
    .promise-num,
    .promise-icon,
    .promise-strike::after {
      transition: none;
    }
  }

  /* --- Closing panel ------------------------------------------------------
     Light: an inverted ink panel. Dark: a raised surface with a lit edge —
     an inverted panel there would be a sheet of white in the middle of a
     dark page.
  --------------------------------------------------------------------------- */
  .cta-card {
    background:
      radial-gradient(
        120% 140% at 50% -20%,
        color-mix(in srgb, var(--color-ink) 88%, var(--color-clay)),
        var(--color-ink) 62%
      );
    color: var(--color-paper);
    border: 1px solid transparent;
  }

  .cta-sub {
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }

  .cta-button {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  :root[data-theme="dark"] .cta-card {
    background:
      radial-gradient(
        120% 140% at 50% -20%,
        color-mix(in srgb, var(--color-surface) 70%, var(--color-clay)),
        var(--color-surface) 58%
      );
    color: var(--color-ink);
    border-color: var(--color-line-strong);
  }

  :root[data-theme="dark"] .cta-sub {
    color: var(--color-ink-muted);
  }

  :root[data-theme="dark"] .cta-button {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* No OS-preference twin for the block above: the root always carries an
     explicit `data-theme`, written before the first paint, so `[data-theme]`
     is the only thing a dark rule ever has to match. */
</style>

<script>
  import { observeSheets } from '../lib/fit';
  import { initBook } from '../scripts/book';

  observeSheets();
  initBook();

  // "What you get": cards rise in once, the strike draws across, and a soft
  // spotlight follows the pointer. Decoration only — the cards are fully
  // visible without this script.
  const promises = document.querySelector<HTMLElement>('[data-promises]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (promises && !calm && 'IntersectionObserver' in window) {
    promises.dataset.reveal = 'pending';
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          delete promises.dataset.reveal;
          io.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    io.observe(promises);
  }
  promises?.querySelectorAll<HTMLElement>('[data-promise-card]').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${event.clientX - r.left}px`);
      card.style.setProperty('--my', `${event.clientY - r.top}px`);
    });
  });
</script>
