  }

  .promise-card:hover .promise-num {
    -webkit-text-stroke-color: color-mix(in srgb, var(--color-clay) 60%, transparent);
    transform: translateY(-2px);
  }

  .promise-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.875rem;
    color: var(--color-clay);
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-clay-soft) 100%, transparent),
        color-mix(in srgb, var(--color-clay) 14%, var(--color-surface))
      );
    border: 1px solid color-mix(in srgb, var(--color-clay) 24%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    transition:
      transform 400ms cubic-bezier(0.3, 1.5, 0.5, 1),
      box-shadow 300ms ease;
  }

  .promise-card:hover .promise-icon {
    transform: translateY(-2px) rotate(-6deg);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 10px 22px -8px color-mix(in srgb, var(--color-clay) 60%, transparent);
  }

  .promise-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
