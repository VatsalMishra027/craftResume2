---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/resume.css';
---

<Layout
  title="Import Existing Resume PDF — CraftResume"
  description="Upload your existing resume in PDF format. Our client-side parser automatically detects sections, roles, and skills with 100% privacy."
>
  <Header />

  <main class="min-h-[calc(100vh-4rem)] pb-20">
    <!-- Stepper Navigation -->
    <div class="border-b border-line bg-surface/80 backdrop-blur-md sticky top-16 z-30">
      <div class="shell flex items-center justify-between py-3">
        <div class="flex items-center gap-2 sm:gap-3" role="tablist" aria-label="Import Progress">
          <span
            data-step-pill="upload"
            aria-current="true"
            class="inline-flex items-center gap-2 rounded-full bg-ink px-4 py-1.5 text-xs font-semibold text-paper transition-colors"
          >
            <span class="size-4 rounded-full bg-paper/20 flex items-center justify-center text-[10px]">1</span>
            Upload PDF
          </span>
          <span class="text-ink-faint text-xs" aria-hidden="true">→</span>
          <span
            data-step-pill="review"
            aria-current="false"
            class="inline-flex items-center gap-2 rounded-full bg-surface px-4 py-1.5 text-xs font-semibold text-ink-muted transition-colors border border-line"
          >
            <span class="size-4 rounded-full bg-ink/10 flex items-center justify-center text-[10px]">2</span>
            Review Content
          </span>
          <span class="text-ink-faint text-xs" aria-hidden="true">→</span>
          <span
            data-step-pill="template"
            aria-current="false"
            class="inline-flex items-center gap-2 rounded-full bg-surface px-4 py-1.5 text-xs font-semibold text-ink-muted transition-colors border border-line"
          >
            <span class="size-4 rounded-full bg-ink/10 flex items-center justify-center text-[10px]">3</span>
            Pick Template
          </span>
        </div>

        <a
          href="/editor"
          class="text-xs text-ink-muted hover:text-ink font-medium transition-colors hidden sm:inline-block"
        >
          Skip & build from scratch →
        </a>
      </div>
    </div>

    <!-- Step 1: Upload PDF -->
    <section data-step="upload" class="shell py-12 lg:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Smart Resume Importer</p>
        <h1 class="display mt-3 text-[clamp(2.2rem,5vw,3.2rem)]">
          Upload your existing resume.<br />
          <span class="font-serif font-normal italic tracking-[-0.01em]">We'll take care of the rest.</span>
        </h1>
        <p class="mt-4 text-base leading-relaxed text-ink-soft">
          Drop your current PDF here. Our browser-based parser extracts your work history, education,
          skills, and contact information without sending any data to a remote server.
        </p>

        <!-- Dropzone -->
        <div
          data-drop-zone
          class="mt-8 relative flex flex-col items-center justify-center rounded-card border-2 border-dashed border-line-strong bg-surface p-10 sm:p-14 text-center transition-all duration-200 hover:border-ink hover:bg-paper-sunk/60 cursor-pointer shadow-lift"
        >
          <input
            type="file"
            accept=".pdf,application/pdf"
            data-file-input
            class="absolute inset-0 size-full opacity-0 cursor-pointer z-10"
            aria-label="Upload PDF resume file"
          />

          <div class="size-16 rounded-full bg-paper-sunk flex items-center justify-center text-ink-muted group-hover:scale-105 transition-transform">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-8">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <path d="M12 18v-6m-3 3 3-3 3 3" />
            </svg>
          </div>

          <h2 class="mt-5 text-base font-semibold text-ink">
            Drag & drop your PDF resume here, or <span class="text-clay underline">browse files</span>
          </h2>
          <p class="mt-1.5 text-xs text-ink-muted">Supports standard PDF resumes with selectable text</p>

          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-paper-sunk px-3 py-1 text-[11px] font-medium text-ink-soft">
              <svg viewBox="0 0 16 16" fill="currentColor" class="size-3 text-emerald-600">
                <path d="M8 1a7 7 0 1 0 7 7A7 7 0 0 0 8 1zm3.2 5.3-3.7 3.7a.8.8 0 0 1-1.1 0L4.8 8.4a.8.8 0 0 1 1.1-1.1L7.4 8.8l3.1-3.1a.8.8 0 0 1 1.1 1.1z"/>
              </svg>
              100% Client-Side Privacy
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-paper-sunk px-3 py-1 text-[11px] font-medium text-ink-soft">
              <svg viewBox="0 0 16 16" fill="currentColor" class="size-3 text-emerald-600">
                <path d="M8 1a7 7 0 1 0 7 7A7 7 0 0 0 8 1zm3.2 5.3-3.7 3.7a.8.8 0 0 1-1.1 0L4.8 8.4a.8.8 0 0 1 1.1-1.1L7.4 8.8l3.1-3.1a.8.8 0 0 1 1.1 1.1z"/>
              </svg>
              Auto Section Detection
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-paper-sunk px-3 py-1 text-[11px] font-medium text-ink-soft">
              <svg viewBox="0 0 16 16" fill="currentColor" class="size-3 text-emerald-600">
                <path d="M8 1a7 7 0 1 0 7 7A7 7 0 0 0 8 1zm3.2 5.3-3.7 3.7a.8.8 0 0 1-1.1 0L4.8 8.4a.8.8 0 0 1 1.1-1.1L7.4 8.8l3.1-3.1a.8.8 0 0 1 1.1 1.1z"/>
              </svg>
              No Server Uploads
            </span>
          </div>
        </div>

        <!-- Progress Spinner (Hidden by default) -->
        <div data-upload-progress class="hidden mt-8 rounded-card border border-line bg-surface p-6 text-center shadow-lift animate-pulse">
          <div class="inline-block size-7 animate-spin rounded-full border-2 border-clay border-t-transparent" role="status">
            <span class="sr-only">Loading...</span>
          </div>
          <p class="mt-3 text-sm font-medium text-ink" data-progress-text>Analyzing document structure…</p>
        </div>
      </div>
    </section>

    <!-- Step 2: Review Extracted Content -->
    <section data-step="review" class="hidden shell py-8 lg:py-12">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-line pb-6">
        <div>
          <h2 class="display text-2xl font-bold tracking-tight text-ink">Review & Verify Content</h2>
          <p class="text-xs text-ink-soft mt-1">
            Check the detected sections below. Any ambiguous fields are highlighted so you can confirm or refine them.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            data-action="reupload"
            class="rounded-full border border-line bg-surface px-4 py-2 text-xs font-medium text-ink-soft hover:text-ink hover:border-line-strong transition-colors"
          >
            Upload different file
          </button>
          <button
            type="button"
            data-action="to-template"
            class="inline-flex h-10 items-center rounded-full bg-ink px-6 text-xs font-semibold text-paper transition-transform duration-200 hover:-translate-y-px active:translate-y-0"
          >
            Continue to Template Selection →
          </button>
        </div>
      </div>

      <!-- Stats Bar -->
      <div class="mt-4 flex flex-wrap gap-2" data-review-stats></div>

      <!-- Section Health Checklist -->
      <div class="mt-4 p-4 rounded-card border border-line bg-surface flex flex-wrap items-center gap-2 sm:gap-3 shadow-sm" data-review-checklist></div>

      <!-- Review Grid -->
      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <!-- Left: Personal Info (5 cols) -->
        <div class="lg:col-span-5 space-y-5">
          <div class="rounded-card border border-line bg-surface p-6 shadow-sm">
            <h3 class="text-sm font-semibold tracking-wide text-ink uppercase mb-4">Personal Info</h3>

            <div class="space-y-3.5">
              <div>
                <div class="flex items-center justify-between">
                  <label class="text-xs font-medium text-ink-soft">Full Name</label>
                  <span data-confidence="basics.fullName"></span>
                </div>
                <input
                  type="text"
                  data-field="basics.fullName"
                  class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-ink focus:outline-none"
                />
              </div>

              <div>
                <div class="flex items-center justify-between">
                  <label class="text-xs font-medium text-ink-soft">Job Title</label>
                  <span data-confidence="basics.title"></span>
                </div>
                <input
                  type="text"
                  data-field="basics.title"
                  class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-ink focus:outline-none"
                />
              </div>

              <div class="grid grid-cols-2 gap-2.5">
                <div>
                  <div class="flex items-center justify-between">
                    <label class="text-xs font-medium text-ink-soft">Email</label>
                    <span data-confidence="basics.email"></span>
                  </div>
                  <input
                    type="email"
                    data-field="basics.email"
                    class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-ink focus:outline-none"
                  />
                </div>
                <div>
                  <div class="flex items-center justify-between">
                    <label class="text-xs font-medium text-ink-soft">Phone</label>
                    <span data-confidence="basics.phone"></span>
                  </div>
                  <input
                    type="text"
                    data-field="basics.phone"
                    class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-ink focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <div class="flex items-center justify-between">
                  <label class="text-xs font-medium text-ink-soft">Location</label>
                  <span data-confidence="basics.location"></span>
                </div>
                <input
                  type="text"
                  data-field="basics.location"
                  placeholder="City, Country"
                  class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-ink focus:outline-none"
                />
              </div>

              <div class="grid grid-cols-2 gap-2.5">
                <div>
                  <label class="text-xs font-medium text-ink-soft">LinkedIn</label>
                  <input
                    type="text"
                    data-field="basics.linkedin"
                    placeholder="linkedin.com/in/..."
                    class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-ink focus:outline-none"
                  />
                </div>
                <div>
                  <label class="text-xs font-medium text-ink-soft">GitHub</label>
                  <input
                    type="text"
                    data-field="basics.github"
                    placeholder="github.com/..."
                    class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-ink focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label class="text-xs font-medium text-ink-soft">Website / Portfolio</label>
                <input
                  type="text"
                  data-field="basics.website"
                  placeholder="yourportfolio.com"
                  class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-ink focus:outline-none"
                />
              </div>

              <div>
                <div class="flex items-center justify-between">
                  <label class="text-xs font-medium text-ink-soft">Professional Summary</label>
                  <span data-confidence="basics.summary"></span>
                </div>
                <textarea
                  data-field="basics.summary"
                  rows="4"
                  class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink leading-relaxed focus:border-ink focus:outline-none resize-y"
                ></textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Sections List (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Work Experience -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold tracking-wide text-ink uppercase">Work Experience</h3>
            </div>
            <div class="space-y-3" data-review-experience></div>
          </div>

          <!-- Education -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold tracking-wide text-ink uppercase">Education</h3>
            </div>
            <div class="space-y-3" data-review-education></div>
          </div>

          <!-- Skills -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold tracking-wide text-ink uppercase">Skills</h3>
            </div>
            <div class="flex flex-wrap gap-1.5 p-4 rounded-card border border-line bg-surface/50" data-review-skills></div>
          </div>

          <!-- Projects -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold tracking-wide text-ink uppercase">Projects</h3>
            </div>
            <div class="space-y-3" data-review-projects></div>
          </div>

          <!-- Certifications -->
          <div data-review-certifications-container class="hidden">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold tracking-wide text-ink uppercase">Certifications</h3>
            </div>
            <div class="space-y-3" data-review-certifications></div>
          </div>

          <!-- Unmapped / Preserved Sections -->
          <div data-review-unmapped-container class="hidden">
            <h3 class="text-sm font-semibold tracking-wide text-ink uppercase mb-3">Custom / Preserved Sections</h3>
            <div class="space-y-3" data-review-unmapped></div>
          </div>

          <!-- Bottom Action Bar -->
          <div class="pt-6 border-t border-line flex items-center justify-between">
            <button
              type="button"
              data-action="reupload"
              class="rounded-full border border-line bg-surface px-4 py-2 text-xs font-medium text-ink-soft hover:text-ink hover:border-line-strong transition-colors"
            >
              Upload different file
            </button>
            <button
              type="button"
              data-action="to-template"
              class="inline-flex h-10 items-center rounded-full bg-ink px-6 text-xs font-semibold text-paper shadow-sm transition-transform duration-200 hover:-translate-y-px active:translate-y-0"
            >
              Continue to Template Selection →
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Step 3: Template Selection -->
    <section data-step="template" class="hidden shell py-8 lg:py-12">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-line pb-6">
        <div>
          <h2 class="display text-2xl font-bold tracking-tight text-ink">Choose Your Template</h2>
          <p class="text-xs text-ink-soft mt-1">
            Pick from 17 print-safe templates. Your extracted content is mapped seamlessly onto whichever one you choose.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            data-action="to-review"
            class="rounded-full border border-line bg-surface px-4 py-2 text-xs font-medium text-ink-soft hover:text-ink hover:border-line-strong transition-colors"
          >
            ← Back to Review
          </button>
          <button
            type="button"
            data-action="launch-editor"
            class="inline-flex h-10 items-center rounded-full bg-ink px-6 text-xs font-semibold text-paper shadow-sm transition-transform duration-200 hover:-translate-y-px active:translate-y-0"
          >
            Open in Editor →
          </button>
        </div>
      </div>

      <!-- Template Thumbnails Grid -->
      <div class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-template-cards>
        <!-- Populated via script with live parsed data! -->
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { initImportWizard } from '../scripts/import-wizard';

  initImportWizard();
</script>
