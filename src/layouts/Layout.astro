---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Editor uses a fixed, non-scrolling body shell. */
  bare?: boolean;
}

const {
  title,
  description = 'CraftResume is a free resume builder. Pick a template, fill in your details, download a clean PDF. No account needed.',
  bare = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />

    {/* Runs before the first paint, so a dark-mode visitor never sees a white
        flash on the way in. Deliberately inline and deliberately tiny — an
        external script would be a round trip the paint has to wait for.

        There are only two themes, and the root always carries one of them:
        the stored choice, or — on a first visit only — whichever one the OS
        would have picked, which the toggle then writes down. */}
    <script is:inline>
      (function () {
        var theme = null;
        try {
          var stored = localStorage.getItem('craftresume:theme:v1');
          if (stored === 'dark' || stored === 'light') theme = stored;
        } catch {
          /* Private browsing: fall through to the system preference. */
        }
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@500;600;700&family=Lato:wght@400;700&family=Roboto:wght@400;500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class={bare ? 'h-dvh overflow-hidden' : ''}>
    <slot />
  </body>
</html>
