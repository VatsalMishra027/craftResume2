---
import '../styles/global.css';
import '../styles/ui-polish.css';

interface Props {
  title: string;
  description?: string;
  /** Editor uses a fixed, non-scrolling body shell. */
  bare?: boolean;
  /** Social share image, relative to the site root. 1200×630 PNG. */
  image?: string;
  imageAlt?: string;
  /** Keep a page out of search results (still followed for links). */
  noindex?: boolean;
}

const {
  title,
  description = 'Free Resume Maker AI is a free resume builder and online resume maker. Pick a template, fill in your details and download a clean PDF. No account needed.',
  bare = false,
  image = '/og-image.png',
  imageAlt = 'Free Resume Maker AI — free resume builder and resume maker with PDF download',
  noindex = false,
} = Astro.props;

// Absolute URLs for canonical and social tags; `site` is set in astro.config.
const site = Astro.site ?? new URL(Astro.url.origin);
// No trailing slash (except the root), matching the site's own links and the sitemap.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    {/* Open Graph — Facebook, LinkedIn, WhatsApp, Slack and most link previews. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Free Resume Maker AI" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    {/* Twitter / X. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16150f" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content="Free Resume Maker AI" />
    <meta name="apple-mobile-web-app-title" content="Free Resume Maker AI" />
    <meta name="color-scheme" content="light dark" />

    {/* Page-specific additions such as structured data. */}
    <slot name="head" />

    {/* Runs before the first paint, so a dark-mode visitor never sees a white
        flash on the way in. Deliberately inline and deliberately tiny — an
        external script would be a round trip the paint has to wait for.

        There are only two themes, and the root always carries one of them:
        the stored choice, or — on a first visit only — whichever one the OS
        would have picked, which the toggle then writes down. */}
    <script is:inline>
      (function () {
        var theme = null;
        try {
          var stored = localStorage.getItem('craftresume:theme:v1');
          if (stored === 'dark' || stored === 'light') theme = stored;
        } catch {
          /* Private browsing: fall through to the system preference. */
        }
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@500;600;700&family=Lato:wght@400;700&family=Roboto:wght@400;500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class={bare ? 'h-dvh overflow-hidden' : ''}>
    <slot />
    <script>
      import { initCardTilt } from '../scripts/ui-polish';

      initCardTilt();
    </script>
  </body>
</html>
