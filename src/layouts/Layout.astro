---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Editor uses a fixed, non-scrolling body shell. */
  bare?: boolean;
}

const {
  title,
  description = 'CraftResume is a free resume builder. Pick a template, fill in your details, download a clean PDF. No account needed.',
  bare = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class={bare ? 'h-dvh overflow-hidden' : ''}>
    <slot />
  </body>
</html>
